---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { HackathonProps } from "@types";
import { trophyTier, type TrophyTier } from "@ui";
import Trophy from "@icons/Trophy.astro";

interface Props {
  hackathons: HackathonProps[];
}

const { hackathons } = Astro.props;

// Podium arrangement: best trophy in the middle, the rest fanning out.
const tierOrder: Record<TrophyTier, number> = { gold: 0, silver: 1, bronze: 2, medal: 3 };
const ranked = hackathons
  .map((h, index) => ({ ...h, index, tier: trophyTier(h.rank) }))
  .sort((a, b) => tierOrder[a.tier] - tierOrder[b.tier]);
const TROPHY_HEIGHT: Record<TrophyTier, string> = {
  gold: "h-44",
  silver: "h-36",
  bronze: "h-32",
  medal: "h-28",
};
const shelf: typeof ranked = [];
ranked.forEach((t, i) => (i % 2 === 0 ? shelf.push(t) : shelf.unshift(t)));
---

<Section text="Hackathons" href="hackathons" wide>
  <div class="cabinet relative mb-16 overflow-hidden rounded-3xl px-4 pt-10 pb-6 sm:px-8">
    <div class="cabinet-glass pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <ul class="shelf relative flex snap-x snap-mandatory items-end gap-4 overflow-x-auto pb-2 sm:justify-center sm:gap-6 sm:overflow-visible">
      {
        shelf.map((t) => (
          <li class="trophy-slot flex w-40 shrink-0 snap-center flex-col items-center sm:w-44" data-tier={t.tier}>
            <div class="spotlight" aria-hidden="true"></div>
            <button
              type="button"
              class="trophy-btn grid h-48 w-full place-items-end justify-center"
              data-trophy={t.index}
              aria-label={`${t.name}: ${t.rank ?? "participant"}. Open match report`}
            >
              <Trophy tier={t.tier} id={`${t.index}`} class:list={["trophy-svg w-auto", TROPHY_HEIGHT[t.tier]]} />
            </button>
            <div class="plaque mt-4 flex min-h-[6.5rem] w-full flex-col justify-center rounded-lg px-3 py-2.5 text-center">
              <p class="font-display text-sm leading-tight font-black tracking-wide text-chalk uppercase">{t.name}</p>
              <p class="mt-1 font-mono text-[10px] text-muted">{t.location}</p>
              {t.rank && <p class="tier-text mt-1.5 font-mono text-[10px] tracking-widest uppercase">{t.rank}</p>}
              <p class="mt-1 font-mono text-[9px] tracking-widest text-chalk/40 uppercase" aria-hidden="true">
                Tap trophy · match report
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="shelf-plank relative mt-2 h-3 rounded-full" aria-hidden="true"></div>
  </div>

  {
    hackathons.map(({ name, location, summary, rank, images, link, preview }, index) => {
      const topDesktop = 98 + index * 40;
      const zIndex = index + 1;
      const safeImages = (Array.isArray(images) ? images : []).slice(0, 3);

      return (
        <div
          style={`--i: ${index}; --card-top-desktop: ${topDesktop}px; z-index: ${zIndex};`}
          class="sticky top-[calc(88px+min(var(--i)*12px,25vh))] mb-12 rounded-2xl border border-neutral/20 bg-black sm:top-[var(--card-top-desktop)]"
        >
          <div
            style="-webkit-overflow-scrolling: touch;"
            class="bg-difu relative z-[1] flex h-[calc(100dvh-140px)] flex-col touch-pan-y overflow-y-scroll rounded-2xl bg-[#1c232d] before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] sm:grid sm:h-auto sm:min-h-0 sm:grid-cols-2 sm:grid-rows-1 sm:touch-auto sm:overflow-visible sm:bg-[#1c232d]/85 md:h-96"
          >
            <div class="flex shrink-0 flex-col px-6 pb-6 pt-10 sm:justify-between sm:py-12">
              <div>
                <h3 class="mb-2 font-serif text-3xl font-medium text-primary">
                  {name}
                </h3>
                <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/70">
                  <span>{location}</span>
                  {rank && <span class="rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs text-white">{rank}</span>}
                </div>
                <p class="text-base text-neutral">{summary}</p>
                {(link || preview) && (
                  <div class="flex flex-wrap gap-3 pt-6">
                    {preview && (
                      <a
                        href={preview}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-xs font-medium text-white transition-colors hover:bg-primary/90 active:scale-95"
                      >
                        <img src="/external.svg" alt="" class="h-4 w-4 invert" />
                        Preview
                      </a>
                    )}
                    {link && (
                      <a
                        href={link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-xs font-medium text-white transition-colors hover:bg-primary/90 active:scale-95"
                      >
                        Project
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>

            <div class="flex flex-col gap-3 p-4 sm:h-auto sm:items-end sm:justify-end sm:overflow-hidden sm:p-0">
              {safeImages.length === 1 && (
                <Image
                  class="w-full rounded-xl object-contain sm:h-[85%] sm:w-full sm:rounded-ss-xl sm:rounded-ee-2xl sm:object-none sm:object-left-top"
                  src={safeImages[0]}
                  alt={name}
                  width="736"
                  height="483"
                />
              )}

              {safeImages.length > 1 && (
                <div class="grid w-full grid-cols-1 gap-3 sm:h-full sm:w-full sm:grid-cols-2 sm:gap-3 sm:p-4">
                  {safeImages.map((img, imgIndex) => (
                    <div class={imgIndex === 0 && safeImages.length === 3 ? "sm:col-span-2" : "col-span-1"}>
                      <Image
                        class="h-auto w-full rounded-xl object-cover"
                        src={img}
                        alt={name}
                        width="736"
                        height="483"
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</Section>

<style>
  .cabinet {
    background:
      radial-gradient(80% 60% at 50% 0%, rgb(232 255 190 / 0.08) 0%, transparent 70%),
      linear-gradient(180deg, #0f2a20 0%, #08170f 100%);
    box-shadow:
      inset 0 0 0 1px rgb(232 239 233 / 0.08),
      inset 0 -40px 80px rgb(0 0 0 / 0.5),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
  }

  .cabinet-glass {
    background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.04) 45%, transparent 55%);
  }

  .shelf {
    scrollbar-width: none;
  }

  .trophy-slot {
    position: relative;
    --tier: #c8ff3d;
  }

  .trophy-slot[data-tier="gold"] { --tier: #ffd75e; }
  .trophy-slot[data-tier="silver"] { --tier: #dfe6ea; }
  .trophy-slot[data-tier="bronze"] { --tier: #e7a066; }

  .spotlight {
    position: absolute;
    top: -2.5rem;
    left: 50%;
    width: 160%;
    height: 18rem;
    transform: translateX(-50%);
    background: conic-gradient(from 160deg at 50% 0%, transparent 0deg, rgb(255 255 255 / 0.07) 20deg, transparent 40deg);
    pointer-events: none;
  }

  .trophy-btn :global(.trophy-svg) {
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.6));
    transition:
      transform 400ms cubic-bezier(0.3, 1.5, 0.5, 1),
      filter 300ms;
  }

  .trophy-btn:hover :global(.trophy-svg),
  .trophy-btn:focus-visible :global(.trophy-svg) {
    transform: translateY(-8px) scale(1.05);
    filter: drop-shadow(0 0 22px color-mix(in srgb, var(--tier) 55%, transparent))
      drop-shadow(0 20px 18px rgb(0 0 0 / 0.6));
  }

  .plaque {
    background: linear-gradient(180deg, #1c2a24, #111c17);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 6px 14px -6px rgb(0 0 0 / 0.8);
  }

  .spotlight {
    transition: opacity 300ms;
    opacity: 0.7;
  }

  .trophy-slot:has(.trophy-btn:hover) .spotlight,
  .trophy-slot:has(.trophy-btn:focus-visible) .spotlight {
    opacity: 1;
    filter: brightness(1.8);
  }

  .plaque {
    border-top: 2px solid transparent;
    transition: border-color 300ms, box-shadow 300ms;
  }

  .trophy-slot:has(.trophy-btn:hover) .plaque,
  .trophy-slot:has(.trophy-btn:focus-visible) .plaque {
    border-top-color: var(--tier);
    box-shadow:
      0 -8px 30px -10px color-mix(in srgb, var(--tier) 60%, transparent),
      0 6px 14px -6px rgb(0 0 0 / 0.8);
  }

  .tier-text {
    color: var(--tier);
  }

  .shelf-plank {
    background: linear-gradient(180deg, rgb(232 239 233 / 0.25), rgb(232 239 233 / 0.05));
    box-shadow: 0 10px 30px rgb(200 255 61 / 0.08);
  }
</style>
