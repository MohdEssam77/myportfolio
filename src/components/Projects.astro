---
import Section from "./Section.astro";
import Media from "./Media.astro";
import type { ProjectProps } from "@types";
import { SITE_CONTENT } from "@config";
import {
  formationOptions,
  isHackathonProject,
  slotsForRows,
  squadNumber,
  type FormationSlot,
} from "@ui";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

const podium = projects.map((p) =>
  isHackathonProject(p, SITE_CONTENT.hackathons),
);

// Every formation the visitor can pick, as a position per player. Lines run
// from the attack to our own goal; the desktop pitch lays them out
// left-to-right (attack on the right), the phone pitch top-to-bottom.
const options = formationOptions(projects.length);
const layouts: Record<string, FormationSlot[]> = Object.fromEntries(
  options.map((o) => {
    const slots = slotsForRows([...o.rows].reverse());
    const indices = projects.map((_, i) => i);
    const order = o.podiumUpFront
      ? [
          ...indices.filter((i) => podium[i]),
          ...indices.filter((i) => !podium[i]),
        ]
      : indices;
    const positions: FormationSlot[] = [];
    order.forEach((player, k) => (positions[player] = slots[k]));
    return [o.id, positions];
  }),
);
const captions = Object.fromEntries(
  options.map((o) => [
    o.id,
    o.podiumUpFront ? `${o.rows.join("-")} · podium up front` : o.label,
  ]),
);
const defaultId = options[0].id;
const formation = captions[defaultId];

// Phone labels get narrower when a line holds more players.
const phoneWidth = (rowSize: number) => Math.min(24, 92 / (rowSize + 1));

const players = projects.map((project, i) => {
  const shortName = project.name.replace(/\s*\(.*\)\s*$/, "");
  return {
    ...project,
    index: i,
    number: squadNumber(i),
    podium: podium[i],
    shortName,
    // "DreamTransport" may wrap as "Dream|Transport" on narrow lines.
    nameParts: shortName.split(/(?<=[a-z])(?=[A-Z])/),
    slot: layouts[defaultId][i],
  };
});
---

<Section text="Featured Projects" href="projects" wide>
  <div
    class="squad"
    data-squad
    data-view="tactics"
    data-layouts={JSON.stringify(layouts)}
    data-captions={JSON.stringify(captions)}
  >
    <div class="squad-toolbar mb-6 flex items-center justify-between gap-4">
      <p class="font-mono text-xs whitespace-nowrap text-muted">
        <span class="text-floodlight">$</span> ls ./squad
        <span class="hidden text-chalk/50 sm:inline"
          >--count {projects.length}</span
        >
      </p>
      <div
        class="flex rounded-full border border-chalk/15 p-1 font-mono text-xs"
        role="group"
        aria-label="Squad view"
      >
        <button
          type="button"
          class="view-btn rounded-full px-4 py-2"
          data-view-btn="tactics"
          aria-pressed="true">Tactics</button
        >
        <button
          type="button"
          class="view-btn rounded-full px-4 py-2"
          data-view-btn="list"
          aria-pressed="false">List</button
        >
      </div>
    </div>

    <div class="view-tactics">
      <div
        class="squad-pitch relative hidden aspect-[16/9] w-full rounded-3xl md:block"
      >
        <svg
          class="absolute inset-0 size-full text-chalk/25"
          viewBox="0 0 1000 562"
          preserveAspectRatio="none"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <rect x="20" y="20" width="960" height="522"></rect>
          <line x1="500" y1="20" x2="500" y2="542"></line>
          <circle cx="500" cy="281" r="70"></circle>
          <circle cx="500" cy="281" r="3" fill="currentColor"></circle>
          <rect x="20" y="141" width="130" height="280"></rect>
          <rect x="20" y="211" width="48" height="140"></rect>
          <rect x="850" y="141" width="130" height="280"></rect>
          <rect x="932" y="211" width="48" height="140"></rect>
          <path d="M150 230a60 60 0 0 1 0 102M850 230a60 60 0 0 0 0 102"></path>
        </svg>

        <p
          class="absolute top-0 left-8 -translate-y-1/2 rounded bg-pitch px-2 py-1 font-mono text-[11px] tracking-[0.2em] text-muted uppercase"
        >
          Formation <span data-formation-label>{formation}</span> ·
          {projects.length} players
        </p>
        <p
          class="absolute top-0 right-8 -translate-y-1/2 rounded bg-pitch px-2 py-1 font-mono text-[11px] tracking-[0.2em] text-muted uppercase"
        >
          Attack →
        </p>

        <ul data-pitch="landscape">
          {
            players.map((p) => (
              <li
                class="slot absolute -translate-x-1/2 -translate-y-1/2"
                data-slot={p.index}
                style={`left:${100 - p.slot.y}%;top:${p.slot.x}%;--i:${p.index}`}
              >
                <button
                  type="button"
                  class="player group flex flex-col items-center gap-2"
                  data-project={p.index}
                  aria-describedby={`player-tip-${p.index}`}
                  aria-label={`${p.name}, number ${p.number}${p.podium ? ", hackathon podium" : ""}`}
                >
                  <span class="jersey relative grid size-16 place-items-center rounded-full border-2 border-chalk/80 bg-pitch font-display text-2xl font-black text-chalk transition-all duration-300 group-hover:-translate-y-1 group-hover:border-floodlight group-hover:bg-floodlight group-hover:text-pitch">
                    {p.number}
                    {p.podium && (
                      <span
                        class="armband absolute -top-1 -right-3 rounded-sm bg-led px-1 font-mono text-[9px] leading-4 font-medium tracking-wider text-pitch"
                        title="Hackathon podium"
                      >
                        POD
                      </span>
                    )}
                  </span>
                  <span class="rounded-md bg-pitch/85 px-2 py-1 font-display text-sm font-bold tracking-wide whitespace-nowrap text-chalk uppercase">
                    {p.shortName}
                  </span>
                </button>
                <div
                  id={`player-tip-${p.index}`}
                  role="tooltip"
                  class:list={[
                    "player-tip pointer-events-none absolute left-1/2 z-20 w-64 -translate-x-1/2 rounded-xl border border-floodlight/30 bg-pitch/95 p-4 text-left shadow-2xl backdrop-blur",
                    p.slot.x < 35 ? "top-full mt-3" : "bottom-full mb-3",
                  ]}
                >
                  <p class="mb-1 font-display text-lg leading-tight font-black text-floodlight uppercase">
                    {p.name}
                  </p>
                  <p class="text-sm text-muted">{p.summary}</p>
                  <p class="mt-2 font-mono text-[10px] tracking-widest text-chalk/60 uppercase">
                    Click to scout →
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:hidden">
        <div
          class="squad-pitch relative mx-auto aspect-[3/4] w-full max-w-md rounded-3xl"
        >
          <svg
            class="absolute inset-0 size-full text-chalk/25"
            viewBox="0 0 400 533"
            preserveAspectRatio="none"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <rect x="16" y="16" width="368" height="501"></rect>
            <line x1="16" y1="266" x2="384" y2="266"></line>
            <circle cx="200" cy="266" r="56"></circle>
            <circle cx="200" cy="266" r="3" fill="currentColor"></circle>
            <rect x="100" y="16" width="200" height="80"></rect>
            <rect x="150" y="16" width="100" height="32"></rect>
            <rect x="100" y="437" width="200" height="80"></rect>
            <rect x="150" y="485" width="100" height="32"></rect>
          </svg>

          <p
            class="absolute top-0 left-6 -translate-y-1/2 rounded bg-pitch px-2 py-1 font-mono text-[10px] tracking-[0.2em] text-muted uppercase"
          >
            <span data-formation-label>{formation}</span> · ↑ Attack
          </p>

          <ul data-pitch="portrait">
            {
              players.map((p) => (
                <li
                  class="slot absolute -translate-x-1/2 -translate-y-1/2"
                  data-slot={p.index}
                  style={`left:${p.slot.x}%;top:${p.slot.y}%;width:${phoneWidth(p.slot.rowSize)}%;--i:${p.index}`}
                >
                  <button
                    type="button"
                    class="player group flex w-full flex-col items-center gap-1.5"
                    data-project={p.index}
                    aria-label={`${p.name}, number ${p.number}${p.podium ? ", hackathon podium" : ""}`}
                  >
                    <span class="jersey relative grid size-12 place-items-center rounded-full border-2 border-chalk/80 bg-pitch font-display text-xl font-black text-chalk transition-colors group-active:border-floodlight group-active:bg-floodlight group-active:text-pitch">
                      {p.number}
                      {p.podium && (
                        <span class="armband absolute -top-1 -right-3 rounded-sm bg-led px-1 font-mono text-[8px] leading-4 font-medium tracking-wider text-pitch">
                          POD
                        </span>
                      )}
                    </span>
                    <span class="max-w-full rounded-md bg-pitch/85 px-1.5 py-0.5 text-center font-display text-[11px] leading-tight font-bold tracking-wide break-words text-chalk uppercase">
                      {p.nameParts.map((part, k) => (
                        <>
                          {k > 0 && <wbr />}
                          {part}
                        </>
                      ))}
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="mt-3 text-center font-mono text-xs text-muted">
          Tap a player to scout them
        </p>
      </div>

      {
        options.length > 1 && (
          <div
            class="mt-5 flex flex-wrap items-center justify-center gap-2 font-mono text-xs"
            role="group"
            aria-label="Formation"
          >
            <span class="mr-1 text-muted">Formation</span>
            {options.map((o) => (
              <button
                type="button"
                class="formation-btn rounded-full px-3.5 py-1.5 ring-1 ring-chalk/15 transition-colors"
                data-formation={o.id}
                aria-pressed={o.id === defaultId ? "true" : "false"}
              >
                {o.label}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <ul class="view-list grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {
        players.map((p) => (
          <li
            class="list-card group flex flex-col overflow-hidden rounded-2xl border border-chalk/10 bg-turf/40 transition-colors hover:border-floodlight/40"
            data-list-card={p.index}
          >
            <div class="relative overflow-hidden bg-pitch">
              <Media
                class="aspect-[736/483] w-full object-cover object-left-top transition-transform duration-500 group-hover:scale-105"
                src={p.image}
                alt={p.name}
                width="736"
                height="483"
              />
              <span class="absolute top-3 left-3 grid size-10 place-items-center rounded-full bg-pitch/90 font-display text-lg font-black text-chalk">
                {p.number}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              {p.podium && (
                <span class="mb-2 inline-block rounded-sm bg-led/15 px-2 py-0.5 font-mono text-[10px] tracking-wider text-led uppercase">
                  Hackathon podium
                </span>
              )}
              <h3 class="mb-2 font-display text-2xl leading-none font-black text-chalk uppercase">
                {p.name}
              </h3>
              <p class="mb-5 text-sm text-muted">{p.summary}</p>
              <div class="mt-auto flex flex-wrap gap-2 font-mono text-xs">
                {p.linkSource && (
                  <a
                    href={p.linkSource}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full bg-floodlight px-4 py-2 font-medium text-pitch"
                  >
                    Source
                  </a>
                )}
                {p.linkPreview && (
                  <a
                    href={p.linkPreview}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-full px-4 py-2 text-chalk ring-1 ring-chalk/25 hover:text-floodlight hover:ring-floodlight"
                  >
                    Preview
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog
    class="scout-dialog m-auto w-[min(920px,calc(100vw-2rem))] bg-transparent p-0 text-chalk backdrop:bg-black/70 backdrop:backdrop-blur-sm"
    aria-label="Project details"
  >
    {
      players.map((p) => (
        <article
          class="scout-card grid overflow-hidden rounded-3xl border border-floodlight/30 bg-turf md:grid-cols-[1.1fr_1fr]"
          data-scout={p.index}
          hidden
        >
          <div class="relative bg-pitch">
            <Media
              class="aspect-[736/483] size-full object-cover object-left-top"
              src={p.image}
              alt={p.name}
              width="736"
              height="483"
            />
            <span class="absolute top-4 left-4 grid size-14 place-items-center rounded-full bg-floodlight font-display text-2xl font-black text-pitch">
              {p.number}
            </span>
          </div>
          <div class="flex flex-col p-6 sm:p-8">
            <p class="mb-2 font-mono text-[11px] tracking-[0.25em] text-muted uppercase">
              Scouting report · {p.podium ? "Hackathon podium" : "Project"}
            </p>
            <h3 class="mb-4 font-display text-4xl leading-none font-black text-chalk uppercase">
              {p.name}
            </h3>
            <p class="mb-8 text-base text-muted">{p.summary}</p>
            <div class="mt-auto flex flex-wrap gap-3">
              {p.linkSource && (
                <a
                  href={p.linkSource}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-kick btn-primary"
                >
                  Source
                </a>
              )}
              {p.linkPreview && (
                <a
                  href={p.linkPreview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-kick btn-ghost"
                >
                  Preview
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
    <button
      type="button"
      class="absolute top-3 right-3 grid size-10 place-items-center rounded-full bg-pitch/80 text-chalk hover:text-floodlight"
      aria-label="Close"
      data-scout-close
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </dialog>
</Section>

<script>
  import { lockScroll } from "@lib/motion";

  // Tactics / List toggle, remembered per visitor.
  const VIEW_KEY = "matchday:squad-view";
  const squad = document.querySelector<HTMLElement>("[data-squad]");
  const viewButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-view-btn]");

  const setView = (view: string) => {
    if (!squad) return;
    squad.dataset.view = view;
    viewButtons.forEach((b) =>
      b.setAttribute("aria-pressed", `${b.dataset.viewBtn === view}`),
    );
    try {
      localStorage.setItem(VIEW_KEY, view);
    } catch {}
  };

  try {
    const saved = localStorage.getItem(VIEW_KEY);
    if (saved === "list" || saved === "tactics") setView(saved);
  } catch {}
  viewButtons.forEach((b) =>
    b.addEventListener("click", () => setView(b.dataset.viewBtn ?? "tactics")),
  );

  // Formation switcher: players run to their slots in the picked formation.
  type Slot = { x: number; y: number; rowSize: number };
  const layouts: Record<string, Slot[]> = JSON.parse(
    squad?.dataset.layouts ?? "{}",
  );
  const captions: Record<string, string> = JSON.parse(
    squad?.dataset.captions ?? "{}",
  );
  const formationButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-formation]");
  const phoneWidth = (rowSize: number) => Math.min(24, 92 / (rowSize + 1));

  const applyFormation = (id: string) => {
    const positions = layouts[id];
    if (!positions) return;
    document.querySelectorAll<HTMLElement>("[data-slot]").forEach((li) => {
      const slot = positions[Number(li.dataset.slot)];
      if (!slot) return;
      if (li.closest("[data-pitch='landscape']")) {
        li.style.left = `${100 - slot.y}%`;
        li.style.top = `${slot.x}%`;
        const tip = li.querySelector(".player-tip");
        const below = slot.x < 35;
        tip?.classList.toggle("top-full", below);
        tip?.classList.toggle("mt-3", below);
        tip?.classList.toggle("bottom-full", !below);
        tip?.classList.toggle("mb-3", !below);
      } else {
        li.style.left = `${slot.x}%`;
        li.style.top = `${slot.y}%`;
        li.style.width = `${phoneWidth(slot.rowSize)}%`;
      }
    });
    document
      .querySelectorAll("[data-formation-label]")
      .forEach((el) => (el.textContent = captions[id]));
    formationButtons.forEach((b) =>
      b.setAttribute("aria-pressed", `${b.dataset.formation === id}`),
    );
  };

  formationButtons.forEach((b) =>
    b.addEventListener("click", () =>
      applyFormation(b.dataset.formation ?? ""),
    ),
  );

  const dialog = document.querySelector<HTMLDialogElement>(".scout-dialog");
  const cards = dialog?.querySelectorAll<HTMLElement>("[data-scout]") ?? [];

  const openScout = (index: string) => {
    if (!dialog) return;
    cards.forEach((card) => (card.hidden = card.dataset.scout !== index));
    dialog.showModal();
    lockScroll(true);
  };

  dialog?.addEventListener("close", () => lockScroll(false));

  document.querySelectorAll<HTMLElement>("[data-project]").forEach((el) => {
    el.addEventListener("click", () => openScout(el.dataset.project ?? ""));
  });

  dialog
    ?.querySelector("[data-scout-close]")
    ?.addEventListener("click", () => dialog.close());
  // Clicking the backdrop (the dialog element itself) closes it.
  dialog?.addEventListener(
    "click",
    (e) => e.target === dialog && dialog.close(),
  );
</script>

<style>
  .slot {
    transition:
      left 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      top 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 700ms ease;
    transition-delay: calc(var(--i) * 40ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .slot {
      transition: none;
    }
  }

  .formation-btn {
    color: var(--color-muted);
  }

  .formation-btn:hover {
    color: var(--color-chalk);
  }

  .formation-btn[aria-pressed="true"] {
    background: var(--color-floodlight);
    color: var(--color-pitch);
    --tw-ring-color: var(--color-floodlight);
  }

  [data-view="tactics"] .view-list,
  [data-view="list"] .view-tactics {
    display: none;
  }

  /* Without JS there is no toggle or dialog, so show the plain list. */
  :global(html:not(.js)) .squad-toolbar,
  :global(html:not(.js)) .view-tactics {
    display: none;
  }

  :global(html:not(.js)) .view-list {
    display: grid;
  }

  .view-btn {
    color: var(--color-muted);
    transition:
      background-color 200ms,
      color 200ms;
  }

  .view-btn[aria-pressed="true"] {
    background: var(--color-floodlight);
    color: var(--color-pitch);
  }

  .scout-dialog[open] .scout-card:not([hidden]) {
    animation: scout-flip 600ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }

  @keyframes scout-flip {
    from {
      opacity: 0;
      transform: perspective(1200px) rotateY(-80deg) scale(0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scout-dialog[open] .scout-card:not([hidden]) {
      animation: none;
    }
  }

  .squad-pitch {
    background:
      repeating-linear-gradient(
        90deg,
        rgb(255 255 255 / 0.025) 0 6.25%,
        transparent 6.25% 12.5%
      ),
      radial-gradient(ellipse at 50% 50%, #1a4535 0%, #0e2b20 75%);
    box-shadow:
      inset 0 0 0 1px rgb(232 239 233 / 0.08),
      inset 0 0 120px rgb(0 0 0 / 0.45);
  }

  .player-tip {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  li:has(.player:hover) .player-tip,
  li:has(.player:focus-visible) .player-tip {
    opacity: 1;
    transform: none;
  }

  li:has(.player:hover),
  li:has(.player:focus-visible) {
    z-index: 10;
  }

  .jersey {
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.8);
  }
</style>
