---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";
import { formationSlots, squadNumber } from "@ui";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

// Landscape pitch: rows run from our goal (left) to the attack (right).
const slots = formationSlots(projects.length);
const players = projects.map((project, i) => ({
  ...project,
  index: i,
  number: squadNumber(i),
  shortName: project.name.replace(/\s*\(.*\)\s*$/, ""),
  left: 100 - slots[i].y,
  top: slots[i].x,
}));
const rows = [...new Set(slots.map((s) => s.y))].length;
---

<Section text="Featured Projects" href="projects" wide>
  <div class="squad-pitch relative mb-16 hidden aspect-[16/9] w-full rounded-3xl md:block">
    <svg
      class="absolute inset-0 size-full text-chalk/25"
      viewBox="0 0 1000 562"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <rect x="20" y="20" width="960" height="522"></rect>
      <line x1="500" y1="20" x2="500" y2="542"></line>
      <circle cx="500" cy="281" r="70"></circle>
      <circle cx="500" cy="281" r="3" fill="currentColor"></circle>
      <rect x="20" y="141" width="130" height="280"></rect>
      <rect x="20" y="211" width="48" height="140"></rect>
      <rect x="850" y="141" width="130" height="280"></rect>
      <rect x="932" y="211" width="48" height="140"></rect>
      <path d="M150 230a60 60 0 0 1 0 102M850 230a60 60 0 0 0 0 102"></path>
    </svg>

    <p class="absolute top-5 left-6 font-mono text-[11px] tracking-[0.2em] text-muted uppercase">
      Formation · {rows} lines · {projects.length} players
    </p>
    <p class="absolute top-5 right-6 font-mono text-[11px] tracking-[0.2em] text-muted uppercase">
      Attack →
    </p>

    <ul>
      {
        players.map((p) => (
          <li class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${p.left}%;top:${p.top}%`}>
            <button
              type="button"
              class="player group flex flex-col items-center gap-2"
              data-project={p.index}
              aria-label={`${p.name}, number ${p.number}`}
            >
              <span class="jersey relative grid size-16 place-items-center rounded-full border-2 border-chalk/80 bg-pitch font-display text-2xl font-black text-chalk transition-all duration-300 group-hover:-translate-y-1 group-hover:border-floodlight group-hover:bg-floodlight group-hover:text-pitch">
                {p.number}
              </span>
              <span class="rounded-md bg-pitch/85 px-2 py-1 font-display text-sm font-bold tracking-wide whitespace-nowrap text-chalk uppercase">
                {p.shortName}
              </span>
            </button>
            <div
              role="tooltip"
              class:list={[
                "player-tip pointer-events-none absolute left-1/2 z-20 w-64 -translate-x-1/2 rounded-xl border border-floodlight/30 bg-pitch/95 p-4 text-left shadow-2xl backdrop-blur",
                p.top < 35 ? "top-full mt-3" : "bottom-full mb-3",
              ]}
            >
              <p class="mb-1 font-display text-lg leading-tight font-black text-floodlight uppercase">{p.name}</p>
              <p class="text-sm text-muted">{p.summary}</p>
              <p class="mt-2 font-mono text-[10px] tracking-widest text-chalk/60 uppercase">Click to scout →</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <dialog class="scout-dialog m-auto w-[min(920px,calc(100vw-2rem))] bg-transparent p-0 text-chalk backdrop:bg-black/70 backdrop:backdrop-blur-sm" aria-label="Project details">
    {
      players.map((p) => (
        <article class="scout-card grid overflow-hidden rounded-3xl border border-floodlight/30 bg-turf md:grid-cols-[1.1fr_1fr]" data-scout={p.index} hidden>
          <div class="relative bg-pitch">
            <Image class="aspect-[736/483] size-full object-cover object-left-top" src={p.image} alt={p.name} width="736" height="483" />
            <span class="absolute top-4 left-4 grid size-14 place-items-center rounded-full bg-floodlight font-display text-2xl font-black text-pitch">
              {p.number}
            </span>
          </div>
          <div class="flex flex-col p-6 sm:p-8">
            <p class="mb-2 font-mono text-[11px] tracking-[0.25em] text-muted uppercase">Scouting report · Project</p>
            <h3 class="mb-4 font-display text-4xl leading-none font-black text-chalk uppercase">{p.name}</h3>
            <p class="mb-8 text-base text-muted">{p.summary}</p>
            <div class="mt-auto flex flex-wrap gap-3">
              {p.linkSource && (
                <a href={p.linkSource} target="_blank" rel="noopener noreferrer" class="btn-kick btn-primary">
                  Source
                </a>
              )}
              {p.linkPreview && (
                <a href={p.linkPreview} target="_blank" rel="noopener noreferrer" class="btn-kick btn-ghost">
                  Preview
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
    <button
      type="button"
      class="absolute top-3 right-3 grid size-10 place-items-center rounded-full bg-pitch/80 text-chalk hover:text-floodlight"
      aria-label="Close"
      data-scout-close
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
  </dialog>

  {
    projects.map(({ name, summary, image, linkPreview, linkSource }, index) => {
      const zIndex = index + 1;
      return (
        <div
          style={`--i: ${index}; z-index: ${zIndex};`}
          class="sticky top-[calc(88px+min(var(--i)*12px,25vh))] mb-12 rounded-2xl border border-neutral/20 bg-black sm:top-[calc(96px+min(var(--i)*28px,30vh))]"
        >
          <div
            class="bg-difu relative z-[1] flex flex-col overflow-hidden rounded-2xl bg-[#1c232d] before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] sm:grid sm:min-h-0 sm:grid-cols-2 sm:grid-rows-1 sm:bg-[#1c232d]/85 md:h-96"
          >
            <div class="flex shrink-0 flex-col px-6 pb-6 pt-10 sm:justify-between sm:py-12">
              <div>
                <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                  {name}
                </h3>
                <p class="text-base text-neutral">{summary}</p>
              </div>
              <div class="flex gap-5 pt-8 text-white">
                {
                  linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-xs leading-5 font-medium text-[#fff] transition-colors hover:bg-primary/90 active:scale-95"
                    >
                      <span class="sm:hidden">
                        <img src="/external.svg" alt="" class="h-4 w-4 invert" />
                      </span>
                      Source
                    </a>
                  )
                }
                {
                  linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-xs leading-5 font-medium text-[#fff] transition-colors hover:bg-primary/90 active:scale-95"
                    >
                      <span class="sm:hidden">
                        <img src="/external.svg" alt="" class="h-4 w-4 invert" />
                      </span>
                      Preview
                    </a>
                  )
                }
              </div>
            </div>
            <div class="flex h-[200px] items-end justify-end overflow-hidden sm:h-auto">
              <Image
                class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-cover object-left-top sm:h-[85%] sm:w-full sm:object-none"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>

<script>
  import { lockScroll } from "@lib/motion";

  const dialog = document.querySelector<HTMLDialogElement>(".scout-dialog");
  const cards = dialog?.querySelectorAll<HTMLElement>("[data-scout]") ?? [];

  const openScout = (index: string) => {
    if (!dialog) return;
    cards.forEach((card) => (card.hidden = card.dataset.scout !== index));
    dialog.showModal();
    lockScroll(true);
  };

  dialog?.addEventListener("close", () => lockScroll(false));

  document.querySelectorAll<HTMLElement>("[data-project]").forEach((el) => {
    el.addEventListener("click", () => openScout(el.dataset.project ?? ""));
  });

  dialog?.querySelector("[data-scout-close]")?.addEventListener("click", () => dialog.close());
  // Clicking the backdrop (the dialog element itself) closes it.
  dialog?.addEventListener("click", (e) => e.target === dialog && dialog.close());
</script>

<style>
  .scout-dialog[open] .scout-card:not([hidden]) {
    animation: scout-flip 600ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }

  @keyframes scout-flip {
    from {
      opacity: 0;
      transform: perspective(1200px) rotateY(-80deg) scale(0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scout-dialog[open] .scout-card:not([hidden]) { animation: none; }
  }

  .squad-pitch {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.025) 0 6.25%, transparent 6.25% 12.5%),
      radial-gradient(ellipse at 50% 50%, #1a4535 0%, #0e2b20 75%);
    box-shadow:
      inset 0 0 0 1px rgb(232 239 233 / 0.08),
      inset 0 0 120px rgb(0 0 0 / 0.45);
  }

  .player-tip {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  li:has(.player:hover) .player-tip,
  li:has(.player:focus-visible) .player-tip {
    opacity: 1;
    transform: none;
  }

  li:has(.player:hover),
  li:has(.player:focus-visible) {
    z-index: 10;
  }

  .jersey {
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.8);
  }
</style>