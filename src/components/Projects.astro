---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";
import { formationSlots, squadNumber } from "@ui";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

// Landscape pitch: rows run from our goal (left) to the attack (right).
const slots = formationSlots(projects.length);
const players = projects.map((project, i) => ({
  ...project,
  index: i,
  number: squadNumber(i),
  shortName: project.name.replace(/\s*\(.*\)\s*$/, ""),
  left: 100 - slots[i].y,
  top: slots[i].x,
}));
const rows = [...new Set(slots.map((s) => s.y))].length;
---

<Section text="Featured Projects" href="projects" wide>
  <div class="squad-pitch relative mb-16 hidden aspect-[16/9] w-full overflow-hidden rounded-3xl md:block">
    <svg
      class="absolute inset-0 size-full text-chalk/25"
      viewBox="0 0 1000 562"
      preserveAspectRatio="none"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <rect x="20" y="20" width="960" height="522"></rect>
      <line x1="500" y1="20" x2="500" y2="542"></line>
      <circle cx="500" cy="281" r="70"></circle>
      <circle cx="500" cy="281" r="3" fill="currentColor"></circle>
      <rect x="20" y="141" width="130" height="280"></rect>
      <rect x="20" y="211" width="48" height="140"></rect>
      <rect x="850" y="141" width="130" height="280"></rect>
      <rect x="932" y="211" width="48" height="140"></rect>
      <path d="M150 230a60 60 0 0 1 0 102M850 230a60 60 0 0 0 0 102"></path>
    </svg>

    <p class="absolute top-5 left-6 font-mono text-[11px] tracking-[0.2em] text-muted uppercase">
      Formation · {rows} lines · {projects.length} players
    </p>
    <p class="absolute top-5 right-6 font-mono text-[11px] tracking-[0.2em] text-muted uppercase">
      Attack →
    </p>

    <ul>
      {
        players.map((p) => (
          <li class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${p.left}%;top:${p.top}%`}>
            <button
              type="button"
              class="player group flex flex-col items-center gap-2"
              data-project={p.index}
              aria-label={`${p.name}, number ${p.number}`}
            >
              <span class="jersey relative grid size-16 place-items-center rounded-full border-2 border-chalk/80 bg-pitch font-display text-2xl font-black text-chalk transition-all duration-300 group-hover:-translate-y-1 group-hover:border-floodlight group-hover:bg-floodlight group-hover:text-pitch">
                {p.number}
              </span>
              <span class="rounded-md bg-pitch/85 px-2 py-1 font-display text-sm font-bold tracking-wide whitespace-nowrap text-chalk uppercase">
                {p.shortName}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  {
    projects.map(({ name, summary, image, linkPreview, linkSource }, index) => {
      const zIndex = index + 1;
      return (
        <div
          style={`--i: ${index}; z-index: ${zIndex};`}
          class="sticky top-[calc(88px+min(var(--i)*12px,25vh))] mb-12 rounded-2xl border border-neutral/20 bg-black sm:top-[calc(96px+min(var(--i)*28px,30vh))]"
        >
          <div
            class="bg-difu relative z-[1] flex flex-col overflow-hidden rounded-2xl bg-[#1c232d] before:absolute before:inset-0 before:z-[-1] before:rounded-2xl before:bg-[url(/raja.png)] before:bg-[length:128px] before:bg-repeat before:opacity-[5%] before:content-[''] sm:grid sm:min-h-0 sm:grid-cols-2 sm:grid-rows-1 sm:bg-[#1c232d]/85 md:h-96"
          >
            <div class="flex shrink-0 flex-col px-6 pb-6 pt-10 sm:justify-between sm:py-12">
              <div>
                <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                  {name}
                </h3>
                <p class="text-base text-neutral">{summary}</p>
              </div>
              <div class="flex gap-5 pt-8 text-white">
                {
                  linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-xs leading-5 font-medium text-[#fff] transition-colors hover:bg-primary/90 active:scale-95"
                    >
                      <span class="sm:hidden">
                        <img src="/external.svg" alt="" class="h-4 w-4 invert" />
                      </span>
                      Source
                    </a>
                  )
                }
                {
                  linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex items-center gap-2 rounded-full bg-primary px-5 py-3 text-xs leading-5 font-medium text-[#fff] transition-colors hover:bg-primary/90 active:scale-95"
                    >
                      <span class="sm:hidden">
                        <img src="/external.svg" alt="" class="h-4 w-4 invert" />
                      </span>
                      Preview
                    </a>
                  )
                }
              </div>
            </div>
            <div class="flex h-[200px] items-end justify-end overflow-hidden sm:h-auto">
              <Image
                class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-cover object-left-top sm:h-[85%] sm:w-full sm:object-none"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>

<style>
  .squad-pitch {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.025) 0 6.25%, transparent 6.25% 12.5%),
      radial-gradient(ellipse at 50% 50%, #1a4535 0%, #0e2b20 75%);
    box-shadow:
      inset 0 0 0 1px rgb(232 239 233 / 0.08),
      inset 0 0 120px rgb(0 0 0 / 0.45);
  }

  .jersey {
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.8);
  }
</style>