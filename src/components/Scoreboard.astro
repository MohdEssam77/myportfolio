---
import Menu from "@icons/Menu.astro";
import { Image } from "astro:assets";
import type { HeaderProps } from "@types";
import { PLAYER, SECTION_MINUTES } from "@ui";

type Props = HeaderProps;

const { siteLogo, navLinks } = Astro.props;

const phases = navLinks.map((link) => ({
  ...link,
  minute: SECTION_MINUTES[link.href.replace("#", "")],
}));
---

<header
  id="scoreboard"
  class="sticky top-0 z-50 px-3 pt-3 sm:px-6"
  data-minutes={JSON.stringify(SECTION_MINUTES)}
>
  <div
    class="scoreboard relative mx-auto flex max-w-6xl items-center gap-2 rounded-2xl border border-chalk/10 bg-pitch/80 py-2 pr-2 pl-2 shadow-[0_10px_40px_-10px_rgb(0_0_0/0.6)] backdrop-blur-md sm:gap-4 sm:pl-3"
  >
    <a href="/" aria-label="Home link" class="shrink-0">
      <Image
        class="rounded-full ring-2 ring-floodlight/60"
        src={siteLogo}
        width="38"
        height="38"
        alt="website logo"
      />
    </a>

    <div class="flex items-center gap-2 font-display text-lg leading-none font-bold uppercase sm:text-xl">
      <span class="tracking-wide text-chalk">
        <span class="md:hidden">HAL</span><span class="hidden md:inline">Halboup</span>
      </span>
      <span class="led-box flex items-center gap-1 rounded-md px-2 py-1 text-led">
        <span data-score-home>0</span><span class="text-led/50">–</span><span>0</span>
      </span>
      <span class="tracking-wide text-muted">
        <span class="lg:hidden">BOR</span><span class="hidden lg:inline">{PLAYER.rival}</span>
      </span>
      <span
        class="match-clock ml-1 flex items-center gap-1.5 rounded-md bg-chalk/5 px-2 py-1 font-mono text-xs font-medium text-chalk normal-case"
        aria-label="Match minute"
      >
        <span class="live-dot size-1.5 rounded-full bg-card-red"></span>
        <span data-clock>0'</span>
      </span>
    </div>

    <button
      type="button"
      id="menu-button"
      class="ml-auto rounded-lg px-2 py-1.5 text-muted sm:hidden"
      aria-expanded="false"
      aria-controls="main-menu"
      aria-label="Open match phases menu"
    >
      <Menu />
    </button>

    <nav
      class="absolute top-full right-0 mt-2 hidden rounded-xl border border-chalk/10 bg-pitch/95 p-3 text-muted sm:static sm:mt-0 sm:ml-auto sm:block sm:border-0 sm:bg-transparent sm:p-0"
      id="main-menu"
    >
      <ul class="gap-1 sm:flex sm:items-center">
        {
          phases.map((link) => (
            <li>
              <a
                class="nav-item group flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-sm font-medium transition-colors hover:text-chalk"
                href={link.href}
              >
                {link.minute !== undefined && (
                  <span class="font-mono text-[11px] text-muted/70 group-[.is-active]:text-floodlight">
                    {link.minute}'
                  </span>
                )}
                {link.text}
              </a>
            </li>
          ))
        }
        <li class="mt-2 sm:mt-0 sm:ml-1">
          <a
            class="inline-flex items-center gap-2 rounded-lg bg-floodlight px-3.5 py-2 text-sm font-semibold text-pitch transition-transform hover:-translate-y-0.5"
            href="/Halboup_Mohammed.pdf"
            download="Mohammed_Halboup_Resume.pdf"
          >
            Resume
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Toggle mobile menu
  const button = document.querySelector("#menu-button");
  const menu = document.querySelector("#main-menu");
  const navItems = document.querySelectorAll<HTMLAnchorElement>("#main-menu .nav-item");

  const toggleMenu = () => {
    menu?.classList.toggle("hidden");
    const isHidden = menu?.classList.contains("hidden");
    button?.setAttribute("aria-expanded", `${!isHidden}`);
  };

  button?.addEventListener("click", toggleMenu);
  navItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (window.matchMedia("(max-width: 639px)").matches) toggleMenu();
    });
  });

  const updateActiveNav = (sectionId: string) => {
    navItems.forEach((item) => {
      const active = item.getAttribute("href") === `#${sectionId}`;
      item.classList.toggle("is-active", active);
      item.classList.toggle("text-chalk", active);
      if (active) item.setAttribute("aria-current", "true");
      else item.removeAttribute("aria-current");
    });
  };

  // Active section = last section whose top is at or above a line near the top of the viewport.
  // This works reliably with sticky layouts where intersection ratio is misleading.
  const getActiveSection = () => {
    const sections = document.querySelectorAll("main section[id]");
    const triggerOffset = 140; // px from top of viewport
    let activeSection = "";

    for (const section of sections) {
      if (section.getBoundingClientRect().top <= triggerOffset) {
        activeSection = section.id;
      }
    }
    return activeSection || sections[0]?.id || "";
  };

  // Every phase reached is a goal for the home side. The rival never scores.
  const homeScore = document.querySelector<HTMLElement>("[data-score-home]");
  let currentPhase = "";

  const announcePhase = (sectionId: string) => {
    if (sectionId === currentPhase) return;
    const ids = Array.from(document.querySelectorAll("main section[id]"), (s) => s.id);
    const goals = Math.max(0, ids.indexOf(sectionId));
    if (homeScore && homeScore.textContent !== `${goals}`) {
      homeScore.textContent = `${goals}`;
      homeScore.classList.remove("goal");
      void homeScore.offsetWidth;
      homeScore.classList.add("goal");
    }
    if (currentPhase) {
      document.dispatchEvent(new CustomEvent("matchday:phase", { detail: { id: sectionId } }));
    }
    currentPhase = sectionId;
  };

  const updateNavFromScroll = () => {
    const activeSection = getActiveSection();
    if (activeSection) {
      updateActiveNav(activeSection);
      announcePhase(activeSection);
    }
  };

  updateNavFromScroll();
  window.addEventListener("scroll", updateNavFromScroll, { passive: true });
  window.addEventListener("resize", updateNavFromScroll);

  // Match clock: section tops are anchored to their kick-off minute and the
  // page bottom to 90'. Scrolling between anchors interpolates the minute.
  const header = document.querySelector<HTMLElement>("#scoreboard");
  const clock = document.querySelector<HTMLElement>("[data-clock]");
  const minutes: Record<string, number> = JSON.parse(header?.dataset.minutes ?? "{}");

  let anchors: { y: number; minute: number }[] = [];

  const measureAnchors = () => {
    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    anchors = Object.entries(minutes)
      .map(([id, minute]) => {
        const el = document.getElementById(id);
        if (!el) return null;
        const y = id === "hero" ? 0 : el.getBoundingClientRect().top + window.scrollY - 140;
        return { y: Math.min(Math.max(y, 0), maxScroll), minute };
      })
      .filter((a): a is { y: number; minute: number } => a !== null)
      .sort((a, b) => a.y - b.y);
    anchors.push({ y: maxScroll, minute: 90 });
  };

  const minuteAt = (y: number) => {
    for (let i = 0; i < anchors.length - 1; i++) {
      const a = anchors[i];
      const b = anchors[i + 1];
      if (y <= b.y) {
        const t = b.y === a.y ? 1 : (y - a.y) / (b.y - a.y);
        return Math.round(a.minute + t * (b.minute - a.minute));
      }
    }
    return 90;
  };

  const updateClock = () => {
    if (!clock || anchors.length < 2) return;
    const atEnd = window.scrollY >= anchors[anchors.length - 1].y - 2;
    clock.textContent = atEnd ? "90+2'" : `${minuteAt(window.scrollY)}'`;
  };

  measureAnchors();
  updateClock();
  window.addEventListener("scroll", updateClock, { passive: true });
  window.addEventListener("resize", () => {
    measureAnchors();
    updateClock();
  });
  window.addEventListener("load", () => {
    measureAnchors();
    updateClock();
  });
</script>

<style>
  .led-box {
    background:
      radial-gradient(circle, rgb(0 0 0 / 0.55) 1px, transparent 1.4px) 0 0 / 3px 3px,
      #050c09;
    box-shadow: inset 0 0 0 1px rgb(255 176 32 / 0.15);
    text-shadow: 0 0 8px rgb(255 176 32 / 0.65);
    font-variant-numeric: tabular-nums;
  }

  .live-dot {
    animation: live 1.6s ease-in-out infinite;
  }

  @keyframes live {
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }

  [data-score-home] {
    display: inline-block;
  }

  [data-score-home]:global(.goal) {
    animation: goal 700ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  @keyframes goal {
    0% { transform: translateY(-80%) scale(1.4); color: var(--color-floodlight); }
    100% { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-score-home]:global(.goal) { animation: none; }
  }

  .nav-item.is-active {
    background: rgb(200 255 61 / 0.08);
  }
</style>
