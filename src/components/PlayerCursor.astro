---
import Ball from "@icons/Ball.astro";
---

<div class="cursor-layer pointer-events-none fixed inset-0 z-[80] opacity-0" aria-hidden="true">
  <div class="pc-player absolute top-0 left-0" data-pc-player>
    <svg class="pc-body" width="28" height="40" viewBox="0 0 28 40" fill="none">
      <g stroke="#0a1f17" stroke-width="1" stroke-linejoin="round">
        <!-- back arm, back leg -->
        <path class="pc-arm-back" d="M10 14l-3.5 6" stroke="#9fcc30" stroke-width="3" stroke-linecap="round"></path>
        <g class="pc-leg-back">
          <path d="M12 27l-0.5 8" stroke="#c48a5e" stroke-width="2.8" stroke-linecap="round"></path>
          <path d="M9.5 35.5h4.5v2.5h-5z" fill="#0a1f17"></path>
        </g>
        <!-- shorts, shirt, head -->
        <path d="M8.5 22.5h11l0.5 5.5h-4.6l-1.4-2-1.4 2H8z" fill="#e8efe9"></path>
        <path d="M9 11.5c1.5-1 3-1.5 5-1.5s3.5 0.5 5 1.5l0.5 11.5h-11z" fill="#c8ff3d"></path>
        <text class="pc-number" x="14" y="20.5" text-anchor="middle" font-size="6.5" font-weight="900" fill="#0a1f17" stroke="none" font-family="ui-sans-serif, system-ui">17</text>
        <circle cx="14" cy="6" r="4.3" fill="#c48a5e"></circle>
        <path d="M9.8 5.4c0-2.8 2-4.2 4.2-4.2 2.4 0 4.3 1.4 4.3 3.9-1.6-0.9-3.7-1.2-5.4-0.6-1.3 0.4-2.3 0.6-3.1 0.9z" fill="#4a2e1c"></path>
        <!-- front leg (the kicking one), front arm -->
        <g class="pc-leg-front">
          <path d="M16 27l0.5 8" stroke="#c48a5e" stroke-width="2.8" stroke-linecap="round"></path>
          <path d="M15 35.5h4.5l0.5 2.5h-5z" fill="#0a1f17"></path>
        </g>
        <path class="pc-arm-front" d="M18 14l3.5 6" stroke="#c8ff3d" stroke-width="3" stroke-linecap="round"></path>
      </g>
    </svg>
  </div>
  <div class="pc-ball absolute top-0 left-0" data-pc-ball>
    <Ball size={12} />
  </div>
</div>

<script>
  import { prefersReducedMotion } from "@lib/motion";

  // #17 follows the real cursor with the ball at his feet.
  // Desktop only; it never replaces the native cursor.
  const layer = document.querySelector<HTMLElement>(".cursor-layer");
  const player = layer?.querySelector<HTMLElement>("[data-pc-player]");
  const ballEl = layer?.querySelector<HTMLElement>("[data-pc-ball]");

  if (layer && player && ballEl && window.matchMedia("(pointer: fine)").matches && !prefersReducedMotion()) {
    // The player stands just below-right of the pointer and runs after it.
    const OFFSET = { x: 12, y: 6 };
    const SIZE = { w: 28, h: 40 };
    const BALL = 12;
    const FOLLOW = 0.12;

    let x = -100;
    let y = -100;
    let targetX = -100;
    let targetY = -100;
    let facing: 1 | -1 = 1;
    let visible = false;
    let spin = 0;
    let ballX = -100;
    let ballY = -100;

    // Where the ball rests: just in front of the front boot.
    const foot = () => ({
      x: x + (facing === 1 ? SIZE.w - 2 : 2),
      y: y + SIZE.h - BALL / 2,
    });

    const show = (on: boolean) => {
      visible = on;
      layer.style.opacity = on ? "1" : "0";
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        targetX = e.clientX + OFFSET.x;
        targetY = e.clientY + OFFSET.y;
        const overField = (e.target as HTMLElement).closest("input, textarea, select, dialog[open]");
        if (!visible && !overField) {
          // Appear in place instead of running in from the last spot.
          x = targetX;
          y = targetY;
          ({ x: ballX, y: ballY } = foot());
        }
        show(!overField);
      },
      { passive: true },
    );

    document.documentElement.addEventListener("pointerleave", () => show(false));

    const frame = () => {
      const dx = (targetX - x) * FOLLOW;
      const dy = (targetY - y) * FOLLOW;
      x += dx;
      y += dy;
      if (Math.abs(dx) > 0.6) facing = dx > 0 ? 1 : -1;
      const running = Math.hypot(dx, dy) > 0.5;

      player.classList.toggle("is-running", running);
      player.classList.toggle("is-left", facing === -1);
      player.style.transform = `translate3d(${x}px, ${y}px, 0) scaleX(${facing})`;

      // The ball follows the boot a touch loosely, so turning drags it across.
      const at = foot();
      const bx = (at.x - ballX) * 0.35;
      ballX += bx;
      ballY += (at.y - ballY) * 0.35;
      spin += bx * 9;
      ballEl.style.transform = `translate3d(${ballX - BALL / 2}px, ${ballY - BALL / 2}px, 0) rotate(${spin}deg)`;

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  .cursor-layer {
    transition: opacity 200ms;
  }

  .pc-player,
  .pc-ball {
    will-change: transform;
    filter: drop-shadow(0 3px 3px rgb(0 0 0 / 0.5));
  }

  .pc-player {
    transform-origin: 14px 20px;
  }

  /* Keeps the shirt number readable when he runs to the left. */
  .pc-number {
    transform-box: fill-box;
    transform-origin: center;
  }

  .is-left .pc-number {
    transform: scaleX(-1);
  }

  .pc-leg-back,
  .pc-leg-front,
  .pc-arm-back,
  .pc-arm-front {
    transform-box: view-box;
  }

  .pc-leg-back {
    transform-origin: 12px 27px;
  }

  .pc-leg-front {
    transform-origin: 16px 27px;
  }

  .pc-arm-back {
    transform-origin: 10px 14px;
  }

  .pc-arm-front {
    transform-origin: 18px 14px;
  }

  .is-running .pc-leg-back,
  .is-running .pc-arm-front {
    animation: stride 280ms ease-in-out infinite alternate;
  }

  .is-running .pc-leg-front,
  .is-running .pc-arm-back {
    animation: stride 280ms ease-in-out infinite alternate-reverse;
  }

  @keyframes stride {
    from {
      transform: rotate(-28deg);
    }
    to {
      transform: rotate(28deg);
    }
  }
</style>
