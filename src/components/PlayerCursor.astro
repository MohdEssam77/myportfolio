---
import Ball from "@icons/Ball.astro";
---

<div class="cursor-layer pointer-events-none fixed inset-0 z-[80] overflow-hidden opacity-0" aria-hidden="true">
  <!-- Before the player, so a ball rolling back passes behind his legs. -->
  <div class="pc-ball absolute top-0 left-0" data-pc-ball>
    <Ball size={12} />
  </div>
  <div class="pc-player absolute top-0 left-0" data-pc-player>
    <svg class="pc-body" width="28" height="40" viewBox="0 0 28 40" fill="none">
      <g stroke="#0a1f17" stroke-width="1" stroke-linejoin="round">
        <!-- back arm, back leg -->
        <path class="pc-arm-back" d="M10 14l-3.5 6" stroke="#9fcc30" stroke-width="3" stroke-linecap="round"></path>
        <g class="pc-leg-back">
          <path d="M12 27l-0.5 8" stroke="#c48a5e" stroke-width="2.8" stroke-linecap="round"></path>
          <path d="M9.5 35.5h4.5v2.5h-5z" fill="#0a1f17"></path>
        </g>
        <!-- shorts, shirt, head -->
        <path d="M8.5 22.5h11l0.5 5.5h-4.6l-1.4-2-1.4 2H8z" fill="#e8efe9"></path>
        <path d="M9 11.5c1.5-1 3-1.5 5-1.5s3.5 0.5 5 1.5l0.5 11.5h-11z" fill="#c8ff3d"></path>
        <text class="pc-number" x="14" y="20.5" text-anchor="middle" font-size="6.5" font-weight="900" fill="#0a1f17" stroke="none" font-family="ui-sans-serif, system-ui">17</text>
        <circle cx="14" cy="6" r="4.3" fill="#c48a5e"></circle>
        <path d="M9.8 5.4c0-2.8 2-4.2 4.2-4.2 2.4 0 4.3 1.4 4.3 3.9-1.6-0.9-3.7-1.2-5.4-0.6-1.3 0.4-2.3 0.6-3.1 0.9z" fill="#4a2e1c"></path>
        <!-- front leg (the kicking one), front arm -->
        <g class="pc-leg-front">
          <path d="M16 27l0.5 8" stroke="#c48a5e" stroke-width="2.8" stroke-linecap="round"></path>
          <path d="M15 35.5h4.5l0.5 2.5h-5z" fill="#0a1f17"></path>
        </g>
        <path class="pc-arm-front" d="M18 14l3.5 6" stroke="#c8ff3d" stroke-width="3" stroke-linecap="round"></path>
      </g>
    </svg>
  </div>
</div>

<script>
  import { prefersReducedMotion } from "@lib/motion";

  // #17 follows the real cursor with the ball at his feet, and shoots it
  // wherever you click. Desktop only; it never replaces the native cursor,
  // and a click is never delayed: the shot plays alongside it.
  const layer = document.querySelector<HTMLElement>(".cursor-layer");
  const player = layer?.querySelector<HTMLElement>("[data-pc-player]");
  const ballEl = layer?.querySelector<HTMLElement>("[data-pc-ball]");

  if (layer && player && ballEl && window.matchMedia("(pointer: fine)").matches && !prefersReducedMotion()) {
    // The player stands just below-right of the pointer and runs after it.
    const OFFSET = { x: 12, y: 6 };
    const SIZE = { w: 28, h: 40 };
    const BALL = 12;
    const FOLLOW = 0.12;

    let x = -100;
    let y = -100;
    let targetX = -100;
    let targetY = -100;
    let facing: 1 | -1 = 1;
    let visible = false;
    let spin = 0;
    let ballX = -100;
    let ballY = -100;
    let ballScale = 1;

    // The shot: windup → flight → bounce → rest → roll back to his feet.
    type State = "feet" | "windup" | "flight" | "bounce" | "rest" | "return";
    let state: State = "feet";
    let stateAt = 0;
    let kickUntil = 0;
    let from = { x: 0, y: 0 };
    let to = { x: 0, y: 0 };
    let flightMs = 0;
    let arc = 0;
    const STRIKE_MS = 150; // the boot meets the ball here in the kick animation
    const setState = (next: State, now: number) => {
      state = next;
      stateAt = now;
    };

    const FIELD = "input, textarea, select, dialog[open]";

    // Where the shot lands: a puff of grass, and an event other parts of the
    // page can react to (the scoreboard does).
    const land = (point: { x: number; y: number }) => {
      const puff = document.createElement("span");
      puff.className = "pc-puff";
      puff.style.transform = `translate3d(${point.x}px, ${point.y}px, 0)`;
      puff.addEventListener("animationend", () => puff.remove());
      layer.append(puff);
      document.dispatchEvent(new CustomEvent("matchday:shot", { detail: point }));
    };

    // Where the ball rests: just in front of the front boot.
    const foot = () => ({
      x: x + (facing === 1 ? SIZE.w - 2 : 2),
      y: y + SIZE.h - BALL / 2,
    });

    const show = (on: boolean) => {
      visible = on;
      layer.style.opacity = on ? "1" : "0";
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        targetX = e.clientX + OFFSET.x;
        targetY = e.clientY + OFFSET.y;
        const overField = (e.target as HTMLElement).closest(FIELD);
        if (!visible && !overField) {
          // Appear in place instead of running in from the last spot.
          x = targetX;
          y = targetY;
          ({ x: ballX, y: ballY } = foot());
        }
        show(!overField);
      },
      { passive: true },
    );

    document.documentElement.addEventListener("pointerleave", () => show(false));

    window.addEventListener(
      "pointerdown",
      (e) => {
        // One shot at a time: clicks while the ball is away just click.
        if (e.pointerType !== "mouse" || e.button !== 0 || !visible || state !== "feet") return;
        if ((e.target as HTMLElement).closest(FIELD)) return;
        const now = performance.now();
        to = { x: e.clientX, y: e.clientY };
        facing = to.x < x + SIZE.w / 2 ? -1 : 1;
        kickUntil = now + 320;
        setState("windup", now);
        player.classList.remove("is-kicking");
        void player.offsetWidth;
        player.classList.add("is-kicking");
        setTimeout(() => player.classList.remove("is-kicking"), 320);
      },
      { passive: true },
    );

    const frame = (now: number) => {
      const dx = (targetX - x) * FOLLOW;
      const dy = (targetY - y) * FOLLOW;
      x += dx;
      y += dy;
      // Mid-kick he keeps facing the shot.
      if (now > kickUntil && Math.abs(dx) > 0.6) facing = dx > 0 ? 1 : -1;
      const running = Math.hypot(dx, dy) > 0.5;

      player.classList.toggle("is-running", running);
      player.classList.toggle("is-left", facing === -1);
      player.style.transform = `translate3d(${x}px, ${y}px, 0) scaleX(${facing})`;

      const at = foot();
      let lift = 0;
      ballScale = 1;
      const elapsed = now - stateAt;

      if (state === "flight") {
        const t = Math.min(1, elapsed / flightMs);
        const ease = 1 - (1 - t) ** 2;
        ballX = from.x + (to.x - from.x) * ease;
        ballY = from.y + (to.y - from.y) * ease;
        lift = arc * 4 * t * (1 - t);
        ballScale = 1 + 0.45 * Math.sin(Math.PI * t);
        spin += 22 * facing;
        if (t === 1) {
          land(to);
          setState("bounce", now);
        }
      } else if (state === "bounce") {
        const t = Math.min(1, elapsed / 200);
        lift = 7 * 4 * t * (1 - t);
        spin += 6 * facing;
        if (t === 1) setState("rest", now);
      } else if (state === "rest") {
        if (elapsed > 220) setState("return", now);
      } else {
        // At his feet (or rolling back): follows the boot a touch loosely,
        // so turning drags the ball across.
        const pull = state === "return" ? 0.14 : 0.35;
        const bx = (at.x - ballX) * pull;
        ballX += bx;
        ballY += (at.y - ballY) * pull;
        spin += bx * 9;
        if (state === "return" && Math.hypot(at.x - ballX, at.y - ballY) < 3) setState("feet", now);
        if (state === "windup" && elapsed > STRIKE_MS) {
          from = { x: ballX, y: ballY };
          const distance = Math.hypot(to.x - from.x, to.y - from.y);
          flightMs = Math.min(650, Math.max(260, 220 + distance * 0.6));
          arc = Math.min(90, 14 + distance * 0.3);
          setState("flight", now);
        }
      }

      ballEl.style.transform = `translate3d(${ballX - BALL / 2}px, ${ballY - BALL / 2 - lift}px, 0) rotate(${spin}deg) scale(${ballScale})`;

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  .cursor-layer {
    transition: opacity 200ms;
  }

  .pc-player,
  .pc-ball {
    will-change: transform;
    filter: drop-shadow(0 3px 3px rgb(0 0 0 / 0.5));
  }

  .pc-player {
    transform-origin: 14px 20px;
  }

  /* Keeps the shirt number readable when he runs to the left. */
  .pc-number {
    transform-box: fill-box;
    transform-origin: center;
  }

  .is-left .pc-number {
    transform: scaleX(-1);
  }

  .pc-leg-back,
  .pc-leg-front,
  .pc-arm-back,
  .pc-arm-front {
    transform-box: view-box;
  }

  .pc-leg-back {
    transform-origin: 12px 27px;
  }

  .pc-leg-front {
    transform-origin: 16px 27px;
  }

  .pc-arm-back {
    transform-origin: 10px 14px;
  }

  .pc-arm-front {
    transform-origin: 18px 14px;
  }

  .is-running .pc-leg-back,
  .is-running .pc-arm-front {
    animation: stride 280ms ease-in-out infinite alternate;
  }

  .is-running .pc-leg-front,
  .is-running .pc-arm-back {
    animation: stride 280ms ease-in-out infinite alternate-reverse;
  }

  /* Backswing, strike, follow-through. Listed after the run cycle so the
     kicking leg wins while he runs. */
  .is-kicking .pc-leg-front {
    animation: kick 320ms ease-out;
  }

  .is-kicking .pc-arm-back {
    animation: kick-arm 320ms ease-out;
  }

  @keyframes kick {
    35% {
      transform: rotate(40deg);
    }
    50% {
      transform: rotate(-80deg);
    }
  }

  @keyframes kick-arm {
    50% {
      transform: rotate(-60deg);
    }
  }

  /* Where the ball lands: a ring of kicked-up grass. */
  :global(.pc-puff) {
    position: absolute;
    top: -14px;
    left: -14px;
    width: 28px;
    height: 28px;
  }

  :global(.pc-puff)::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    border: 2px solid var(--color-floodlight);
    animation: puff 450ms ease-out forwards;
  }

  @keyframes puff {
    from {
      transform: scale(0.2);
      opacity: 0.9;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @keyframes stride {
    from {
      transform: rotate(-28deg);
    }
    to {
      transform: rotate(28deg);
    }
  }
</style>
