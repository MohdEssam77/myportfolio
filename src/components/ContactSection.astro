---
import Section from "./Section.astro";
import { SITE_CONTENT } from "@config";
import { PLAYER } from "@ui";

const fields: {
  id: string;
  label: string;
  type: "text" | "email" | "tel";
  placeholder: string;
  required: boolean;
}[] = [
  {
    id: "firstName",
    label: "First Name",
    type: "text",
    placeholder: "Abdoh",
    required: true,
  },
  {
    id: "lastName",
    label: "Last Name",
    type: "text",
    placeholder: "Rabal",
    required: true,
  },
  {
    id: "email",
    label: "Email",
    type: "email",
    placeholder: "abdohrabal1@example.com",
    required: true,
  },
  {
    id: "phone",
    label: "Phone Number",
    type: "tel",
    placeholder: "+49 176 74522561",
    required: false,
  },
];
---

<Section text="Contact" href="contact">
  <form
    id="contact-form"
    action="/api/contact"
    method="POST"
    class="contract relative rounded-3xl"
  >
    <header
      class="flex flex-wrap items-center justify-between gap-3 border-b border-dashed border-chalk/15 px-6 py-4 font-mono text-[11px] tracking-[0.2em] text-muted uppercase sm:px-8"
    >
      <span>Transfer offer · Form TR-{PLAYER.number}</span>
      <span class="text-chalk/80"
        >Player: {SITE_CONTENT.hero.name} #{PLAYER.number}</span
      >
    </header>

    <div class="px-6 py-8 sm:px-8">
      <div class="grid gap-x-6 gap-y-7 sm:grid-cols-2">
        {
          fields.map((field, i) => (
            <div class="field flex flex-col gap-2">
              <label
                for={field.id}
                class="font-mono text-[11px] tracking-[0.2em] text-muted uppercase"
              >
                <span class="text-chalk/40">§{i + 1}</span> {field.label}{" "}
                {field.required && <span class="text-floodlight">*</span>}
              </label>
              <input
                type={field.type}
                id={field.id}
                name={field.id}
                required={field.required}
                placeholder={field.placeholder}
                class="contract-input"
              />
            </div>
          ))
        }
      </div>

      <div class="field mt-7 flex flex-col gap-2">
        <label
          for="message"
          class="font-mono text-[11px] tracking-[0.2em] text-muted uppercase"
        >
          <span class="text-chalk/40">§{fields.length + 1}</span> Message <span
            class="text-floodlight">*</span
          >
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="Your message here..."
          class="contract-input resize-none"></textarea>
      </div>

      <div class="mt-10 flex flex-wrap items-end justify-between gap-6">
        <div class="font-mono text-[11px] text-muted">
          <p
            class="signature mb-1 w-48 border-b border-chalk/30 pb-1 font-display text-2xl text-chalk/80 italic"
          >
            &nbsp;
          </p>
          Signed digitally on submit
        </div>
        <button type="submit" class="btn-kick btn-primary" data-submit>
          <span data-submit-label>Send Offer</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>

      <div
        id="form-result"
        class="mt-4 hidden text-sm"
        role="status"
        aria-live="polite"
      >
      </div>
    </div>
  </form>
</Section>

<style>
  .contract {
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 31px,
        rgb(232 239 233 / 0.025) 31px 32px
      ),
      linear-gradient(180deg, #10291f, #0a1b14);
    box-shadow:
      inset 0 0 0 1px rgb(232 239 233 / 0.1),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
  }

  [data-submit].is-pending {
    cursor: progress;
    opacity: 0.85;
  }

  [data-submit].is-pending svg {
    animation: whistle 500ms ease-in-out infinite alternate;
  }

  @keyframes whistle {
    from {
      transform: translateX(-2px) rotate(-12deg);
    }
    to {
      transform: translateX(2px) rotate(12deg);
    }
  }

  .contract::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background:
      repeating-linear-gradient(
        45deg,
        rgb(232 239 233 / 0.18) 0 1px,
        transparent 1px 18px
      ),
      repeating-linear-gradient(
        -45deg,
        rgb(232 239 233 / 0.18) 0 1px,
        transparent 1px 18px
      );
  }

  .contract.goal {
    animation: net-bulge 700ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  .contract.goal::after {
    animation: net-show 1.2s ease-out;
  }

  @keyframes net-bulge {
    35% {
      transform: scale(1.025) translateY(-6px);
    }
  }

  @keyframes net-show {
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  :global(.result) {
    color: var(--color-chalk);
  }

  :global(.result .ref-card) {
    width: 0.9rem;
    height: 1.25rem;
    flex-shrink: 0;
    border-radius: 2px;
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.4);
    animation: show-card 450ms cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  :global(.result[data-outcome="goal"]) {
    color: var(--color-floodlight);
  }
  :global(.result[data-outcome="goal"] .ref-card) {
    border-radius: 9999px;
    width: 1rem;
    height: 1rem;
    background: var(--color-floodlight);
  }
  :global(.result[data-outcome="yellow"] .ref-card) {
    background: var(--color-card-yellow);
  }
  :global(.result[data-outcome="red"]) {
    color: #ff8a8a;
  }
  :global(.result[data-outcome="red"] .ref-card) {
    background: var(--color-card-red);
  }

  @keyframes show-card {
    from {
      transform: translateY(10px) rotate(-25deg) scale(0.6);
      opacity: 0;
    }
    to {
      transform: rotate(-8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.result .ref-card) {
      animation: none;
    }
  }

  .contract-input:user-invalid {
    border-bottom-color: var(--color-card-yellow);
  }

  .contract-input {
    border: 0;
    border-bottom: 1.5px dashed rgb(232 239 233 / 0.25);
    background: transparent;
    padding: 0.5rem 0;
    color: var(--color-chalk);
    outline: none;
    transition: border-color 200ms;
  }

  .contract-input::placeholder {
    color: rgb(138 165 151 / 0.45);
  }

  .contract-input:focus {
    border-bottom-style: solid;
    border-bottom-color: var(--color-floodlight);
  }

  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  textarea:-webkit-autofill,
  textarea:-webkit-autofill:hover,
  textarea:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-chalk) !important;
    background-color: transparent !important;
    transition: background-color 5000s ease-in-out 0s;
  }

  input:-webkit-autofill::first-line,
  textarea:-webkit-autofill::first-line {
    color: var(--color-chalk) !important;
  }
</style>

<script>
  import confetti from "canvas-confetti";
  import { prefersReducedMotion } from "@lib/motion";

  const form = document.getElementById("contact-form") as HTMLFormElement;
  const result = document.getElementById("form-result") as HTMLDivElement;
  const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
  const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");

  const setPending = (pending: boolean) => {
    if (!submit || !submitLabel) return;
    submit.disabled = pending;
    submit.classList.toggle("is-pending", pending);
    submitLabel.textContent = pending ? "Whistle blown…" : "Send Offer";
  };

  // GOAL: the net ripples, the signature line signs itself, confetti flies.
  const celebrate = (name: string) => {
    const signature = form.querySelector<HTMLElement>(".signature");
    if (signature) signature.textContent = name;
    document.dispatchEvent(new CustomEvent("matchday:sfx", { detail: "goal" }));
    if (prefersReducedMotion()) return;

    form.classList.remove("goal");
    void form.offsetWidth;
    form.classList.add("goal");

    const rect = submit?.getBoundingClientRect();
    confetti({
      particleCount: 120,
      spread: 75,
      startVelocity: 45,
      origin: rect
        ? {
            x: (rect.left + rect.width / 2) / window.innerWidth,
            y: rect.top / window.innerHeight,
          }
        : { y: 0.7 },
      colors: ["#c8ff3d", "#e8efe9", "#ffb020"],
      disableForReducedMotion: true,
    });
  };

  type Outcome = "goal" | "yellow" | "red";

  // Referee decisions: goal = sent, yellow = fix your input, red = server/network error.
  const showResult = (outcome: Outcome, text: string) => {
    result.dataset.outcome = outcome;
    result.className = "result mt-6 flex items-center gap-3 text-sm";
    result.replaceChildren();
    const card = document.createElement("span");
    card.className = "ref-card";
    card.setAttribute("aria-hidden", "true");
    const message = document.createElement("span");
    message.textContent = text;
    result.append(card, message);
  };

  form.addEventListener(
    "invalid",
    () =>
      showResult("yellow", "Yellow card! Please fill in all required fields."),
    true,
  );

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    setPending(true);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
      });

      const data = await response.json();

      if (data.success) {
        celebrate(
          `${formData.get("firstName") ?? ""} ${formData.get("lastName") ?? ""}`.trim(),
        );
        showResult(
          "goal",
          "Thank you! Your message has been sent successfully.",
        );
        form.reset();
      } else {
        showResult(
          response.status === 400 ? "yellow" : "red",
          data.message || "Something went wrong. Please try again.",
        );
      }
    } catch {
      showResult("red", "Something went wrong. Please try again.");
    } finally {
      setPending(false);
    }
  });
</script>
