---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";
import { PLAYER } from "@ui";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
const quote = description.replace(/\s+/g, " ").trim();
const initials = name
  .split(" ")
  .map((part) => part[0])
  .join("");
const wallTiles = Array.from({ length: 48 }, (_, i) =>
  [initials, `#${PLAYER.number}`, `${PLAYER.uniShort} · 05`][i % 3],
);
---

<Section text="About Me" href="about" wide>
  <div class="press relative overflow-hidden rounded-3xl">
    <div class="sponsor-wall pointer-events-none absolute inset-0 grid grid-cols-6 content-start gap-x-6 gap-y-8 p-6 sm:grid-cols-8" aria-hidden="true">
      {wallTiles.map((tile) => <span>{tile}</span>)}
    </div>

    <div class="relative grid items-center gap-12 p-6 sm:p-10 md:grid-cols-[1fr_auto] md:gap-10 lg:p-14">
      <blockquote class="relative">
        <p class="relative text-lg leading-relaxed text-chalk sm:text-xl" data-quote>
          <span class="sr-only">{quote}</span>
          <span class="invisible" aria-hidden="true">{quote}</span>
          <span class="absolute inset-0" aria-hidden="true"
            ><span data-typed>{quote}</span><span class="caret" data-caret></span></span
          >
        </p>
        <footer class="mt-6 font-mono text-xs tracking-[0.2em] text-muted uppercase">
          — {name}, #{PLAYER.number}
        </footer>
      </blockquote>

      <div class="mx-auto h-80 w-64 flex-shrink-0 rotate-[5deg] bg-white p-4 md:rotate-[7deg]">
        <Image class="object-cover" src={image} width="260" height="260" alt={name} />
      </div>
    </div>
  </div>
</Section>

<script>
  import { prefersReducedMotion } from "@lib/motion";

  // Type the interview answer out once it's on screen. Click to skip.
  const quote = document.querySelector<HTMLElement>("[data-quote]");
  const typed = quote?.querySelector<HTMLElement>("[data-typed]");
  const caret = quote?.querySelector<HTMLElement>("[data-caret]");

  if (quote && typed && !prefersReducedMotion()) {
    const full = typed.textContent ?? "";
    let shown = 0;
    let done = false;
    typed.textContent = "";

    const finish = () => {
      done = true;
      typed.textContent = full;
      caret?.classList.add("is-done");
    };

    const tick = () => {
      if (done) return;
      shown = Math.min(full.length, shown + 2);
      typed.textContent = full.slice(0, shown);
      if (shown < full.length) requestAnimationFrame(tick);
      else finish();
    };

    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        requestAnimationFrame(tick);
      },
      { threshold: 0.5 },
    );
    observer.observe(quote);
    quote.addEventListener("click", finish);
  }
</script>

<style>
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--color-floodlight);
    animation: blink 1s steps(1) infinite;
  }

  .caret.is-done {
    animation:
      blink 1s steps(1) 3,
      caret-out 0s 3s forwards;
  }

  @keyframes caret-out {
    to { opacity: 0; }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret { display: none; }
  }

  .press {
    background: linear-gradient(180deg, #0f2b20, #091a12);
    box-shadow:
      inset 0 0 0 1px rgb(232 239 233 / 0.08),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
  }

  .sponsor-wall {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    color: rgb(232 239 233 / 0.045);
    text-transform: uppercase;
    white-space: nowrap;
    transform: rotate(-8deg) scale(1.3);
  }

  .sponsor-wall span:nth-child(odd) {
    color: rgb(200 255 61 / 0.05);
  }
</style>
