---
import Media from "./Media.astro";
import { SITE_CONTENT } from "@config";
import { PLAYER, deriveStats } from "@ui";

const { hero, about } = SITE_CONTENT;
const lastName = hero.name.split(" ").slice(1).join(" ");
const stats = deriveStats(SITE_CONTENT);

const statCells = [
  { value: stats.projects, label: "PRJ", title: "Projects" },
  { value: stats.hackathons, label: "HCK", title: "Hackathons" },
  { value: stats.podiums, label: "POD", title: "Podium finishes" },
  { value: stats.wins, label: "WIN", title: "Hackathon wins" },
  { value: stats.roles, label: "EXP", title: "Roles" },
];
---

<div class="player-card relative w-[min(330px,86vw)]" data-player-card>
  <div class="card-tilt relative aspect-[33/47]">
    <div class="card-inner relative size-full">
      <article
        class="card-face card-front absolute inset-0 flex flex-col overflow-hidden rounded-[28px] border border-floodlight/30 p-5"
        aria-label={`Player card: ${hero.name}`}
      >
        <svg
          class="pointer-events-none absolute inset-0 size-full text-chalk/[0.07]"
          viewBox="0 0 330 470"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <rect x="14" y="14" width="302" height="442" rx="18"></rect>
          <line x1="14" y1="235" x2="316" y2="235"></line>
          <circle cx="165" cy="235" r="52"></circle>
          <rect x="95" y="14" width="140" height="56"></rect>
          <rect x="95" y="400" width="140" height="56"></rect>
        </svg>

        <header class="relative z-10 flex items-start justify-between">
          <div>
            <p class="font-display text-6xl leading-[0.8] font-black text-floodlight">{PLAYER.number}</p>
            <p class="mt-1 font-mono text-[10px] tracking-[0.2em] text-chalk/70 uppercase">Full-stack</p>
          </div>
          <div class="flex flex-col items-end gap-1 font-mono text-[10px] tracking-wider uppercase">
            <span class="rounded border border-chalk/20 px-1.5 py-0.5 text-chalk/80">{PLAYER.uniShort} · CS</span>
            <span class="rounded border border-chalk/20 px-1.5 py-0.5 text-chalk/80">{PLAYER.club}</span>
          </div>
        </header>

        <div class="relative z-10 mt-3 flex-1 overflow-hidden rounded-2xl border border-chalk/10">
          <Media
            class="size-full origin-[32%_40%] scale-[2.1] object-cover"
            src={about.image}
            width="600"
            height="800"
            alt={hero.name}
            loading="eager"
          />
          <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-turf to-transparent"></div>
          <p
            class="absolute inset-x-0 bottom-1 text-center font-display text-[2.6rem] leading-none font-black tracking-wide text-chalk uppercase"
          >
            {lastName}
          </p>
        </div>

        <dl class="relative z-10 mt-4 grid grid-cols-5 gap-1 text-center">
          {
            statCells.map(({ value, label, title }) => (
              <div title={title}>
                <dt class="sr-only">{title}</dt>
                <dd class="font-display text-3xl leading-none font-black text-chalk">{value}</dd>
                <span aria-hidden="true" class="font-mono text-[10px] tracking-widest text-muted">
                  {label}
                </span>
              </div>
            ))
          }
        </dl>

        <footer
          class="relative z-10 mt-3 flex items-center justify-between border-t border-chalk/10 pt-2.5 font-mono text-[10px] text-muted"
        >
          <span>CS @ {PLAYER.uniShort} · {PLAYER.club}</span>
          <span class="text-floodlight/80">main@{PLAYER.number}c0de</span>
        </footer>
        <div class="card-holo pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>
        <div class="card-glare pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>
      </article>

      <article
        class="card-face card-back absolute inset-0 flex flex-col overflow-hidden rounded-[28px] border border-floodlight/30 p-6"
        aria-label="Scouting report"
        inert
      >
        <p class="font-mono text-[10px] tracking-[0.25em] text-floodlight uppercase">
          Scouting report · #{PLAYER.number}
        </p>
        <h3 class="mt-3 font-display text-4xl leading-none font-black text-chalk uppercase">{hero.name}</h3>
        <p class="mt-1 font-display text-xl font-bold tracking-wide text-floodlight uppercase">{hero.specialty}</p>
        <p class="mt-4 text-sm text-muted">{hero.summary}</p>

        <ul class="mt-auto space-y-2 font-mono text-xs">
          <li>
            <a class="flex items-center justify-between rounded-lg border border-chalk/10 px-3 py-2.5 text-chalk hover:border-floodlight/60" href={`mailto:${hero.email}`}>
              <span class="text-muted">email</span><span class="truncate pl-3">{hero.email}</span>
            </a>
          </li>
          {
            hero.phone && (
              <li>
                <a class="flex items-center justify-between rounded-lg border border-chalk/10 px-3 py-2.5 text-chalk hover:border-floodlight/60" href={`tel:${hero.phone}`}>
                  <span class="text-muted">phone</span><span>{hero.phone}</span>
                </a>
              </li>
            )
          }
          <li>
            <a class="block rounded-lg bg-floodlight px-3 py-2.5 text-center font-semibold text-pitch" href="#contact">
              Make an offer →
            </a>
          </li>
        </ul>
      </article>
    </div>
  </div>

  <button
    type="button"
    class="mx-auto mt-5 flex items-center gap-2 rounded-full border border-chalk/15 px-4 py-2 font-mono text-xs text-muted transition-colors hover:border-floodlight/60 hover:text-chalk"
    aria-pressed="false"
    data-card-flip
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path>
    </svg>
    <span data-flip-label>Flip card</span>
  </button>
</div>

<script>
  import { prefersReducedMotion } from "@lib/motion";

  const card = document.querySelector<HTMLElement>("[data-player-card]");
  const tilt = card?.querySelector<HTMLElement>(".card-tilt");
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // px/py are the pointer position over the card, 0..1.
  const apply = (px: number, py: number) => {
    if (!tilt) return;
    tilt.style.setProperty("--rx", `${(0.5 - py) * 18}deg`);
    tilt.style.setProperty("--ry", `${(px - 0.5) * 22}deg`);
    tilt.style.setProperty("--mx", `${px * 100}%`);
    tilt.style.setProperty("--my", `${py * 100}%`);
  };

  const reset = () => {
    card?.classList.remove("is-hover");
    tilt?.style.removeProperty("--rx");
    tilt?.style.removeProperty("--ry");
  };

  // Flip between the player card and the scouting report.
  const flipButton = card?.querySelector<HTMLButtonElement>("[data-card-flip]");
  const front = card?.querySelector<HTMLElement>(".card-front");
  const back = card?.querySelector<HTMLElement>(".card-back");

  flipButton?.addEventListener("click", () => {
    const flipped = !card?.classList.contains("is-flipped");
    card?.classList.toggle("is-flipped", flipped);
    flipButton.setAttribute("aria-pressed", `${flipped}`);
    front?.toggleAttribute("inert", flipped);
    back?.toggleAttribute("inert", !flipped);
    const label = flipButton.querySelector("[data-flip-label]");
    if (label) label.textContent = flipped ? "Flip back" : "Flip card";
  });

  if (card && tilt && !prefersReducedMotion()) {
    card.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const rect = card.getBoundingClientRect();
      card.classList.add("is-hover");
      apply((e.clientX - rect.left) / rect.width, (e.clientY - rect.top) / rect.height);
    });
    card.addEventListener("pointerleave", reset);

    // Phones that expose orientation without a permission prompt get gyro tilt.
    const DOE = window.DeviceOrientationEvent as unknown as { requestPermission?: unknown };
    if (matchMedia("(pointer: coarse)").matches && DOE && typeof DOE.requestPermission !== "function") {
      window.addEventListener("deviceorientation", (e) => {
        if (e.beta === null || e.gamma === null) return;
        card.classList.add("is-hover");
        apply(clamp((e.gamma + 25) / 50), clamp((e.beta - 20) / 50));
      });
    }
  }
</script>

<style>
  .player-card {
    animation: float 6s ease-in-out infinite;
  }

  .player-card.is-hover {
    animation-play-state: paused;
  }

  .card-tilt {
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .is-hover .card-tilt {
    transition: transform 90ms linear;
  }

  .card-inner {
    transform-style: preserve-3d;
    transition: transform 750ms cubic-bezier(0.3, 1.3, 0.4, 1);
  }

  .is-flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    backface-visibility: hidden;
  }

  .card-back {
    transform: rotateY(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-inner { transition: none; }
  }

  .card-holo,
  .card-glare {
    border-radius: inherit;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .card-holo {
    background:
      repeating-linear-gradient(
        115deg,
        #ff4fd8 0%,
        #3dfcff 8%,
        #c8ff3d 16%,
        #ffb020 24%,
        #ff4fd8 32%
      );
    background-size: 300% 300%;
    background-position: var(--mx, 50%) var(--my, 50%);
    mix-blend-mode: color-dodge;
    filter: saturate(1.2);
  }

  .card-glare {
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      rgb(255 255 255 / 0.35) 0%,
      transparent 45%
    );
    mix-blend-mode: overlay;
  }

  .is-hover .card-holo {
    opacity: 0.28;
  }

  .is-hover .card-glare {
    opacity: 1;
  }

  @keyframes float {
    50% { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .player-card { animation: none; }
  }

  .card-face {
    background:
      radial-gradient(120% 80% at 50% 0%, var(--color-turf-light) 0%, transparent 60%),
      linear-gradient(160deg, var(--color-turf) 0%, #0b261c 55%, #07160f 100%);
    box-shadow:
      0 30px 60px -20px rgb(0 0 0 / 0.7),
      0 0 0 1px rgb(200 255 61 / 0.08) inset;
  }
</style>
