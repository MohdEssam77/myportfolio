---
import type { HeroProps } from "@types";
import { PLAYER } from "@ui";
import Ball from "@icons/Ball.astro";
type Props = HeroProps;

const { name, specialty, summary, phone } = Astro.props;
const [firstName, ...rest] = name.split(" ");
const lastName = rest.join(" ");
---

<section
  class="hero relative grid min-h-[calc(100dvh-80px)] content-center items-center gap-14 py-16 lg:grid-cols-[1.25fr_1fr] lg:gap-10"
  id="hero"
>
  <div class="relative z-10">
    <p class="mb-6 flex items-center gap-3 font-mono text-xs tracking-[0.25em] text-muted uppercase">
      <span class="inline-flex items-center gap-2 rounded bg-card-red/15 px-2 py-1 text-card-red">
        <span class="size-1.5 rounded-full bg-card-red"></span>Live
      </span>
      Kick-off · #{PLAYER.number}
    </p>

    <h1
      class="hero-name mb-5 font-display leading-[0.9] font-black tracking-tight text-chalk uppercase"
      aria-label={name}
    >
      <span class="slam block text-[clamp(4.5rem,15vw,10.5rem)]">{firstName}</span>
      <span
        class="slam slam-late outline-text block text-[clamp(4.5rem,15vw,10.5rem)] text-transparent"
        >{lastName}</span
      >
    </h1>

    <p class="mb-6 font-display text-4xl font-bold tracking-wide text-floodlight uppercase sm:text-5xl">
      {specialty}
    </p>
    <p class="mb-10 max-w-xl text-base text-muted md:text-lg">
      {summary}
    </p>

    <div class="flex flex-wrap gap-3">
      {
        phone && (
          <a
            data-magnetic
            class="btn-kick btn-ghost"
            href={`tel:${phone}`}
          >
            Call Me
          </a>
        )
      }
      <a data-magnetic class="btn-kick btn-primary" href="#contact">Contact Me</a>
      <a
        data-magnetic
        class="btn-kick btn-ghost"
        href="/Halboup_Mohammed.pdf"
        download="Mohammed_Halboup_Resume.pdf">Download Resume</a
      >
    </div>
  </div>

  <div class="relative flex justify-center lg:justify-end" data-card-slot>
    <slot name="card" />
  </div>

  <a
    href="#experience"
    class="scroll-cue absolute bottom-2 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[11px] tracking-[0.25em] text-muted uppercase transition-colors hover:text-chalk lg:flex"
  >
    <span class="ball-track relative block h-6 w-24">
      <Ball class="ball absolute top-0 left-0" size={22} />
    </span>
    Scroll to kick off
  </a>
</section>

<script>
  import { autoKickoff } from "@lib/kickoff";
  autoKickoff();
</script>

<style>
  .outline-text {
    -webkit-text-stroke: 2px var(--color-chalk);
  }

  :global(html.intro) .slam {
    opacity: 0;
  }

  :global(html.kicked) .slam {
    animation: slam 520ms cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }

  :global(html.kicked) .slam-late {
    animation-delay: 140ms;
  }

  :global(html.kicked) .hero {
    animation: impact 320ms ease-out 480ms;
  }

  @keyframes slam {
    0% {
      opacity: 0;
      transform: scale(1.6) translateY(-12px);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .ball {
    animation: roll 2.8s ease-in-out infinite;
  }

  @keyframes roll {
    0%, 100% { transform: translateX(0) rotate(0deg); }
    50% { transform: translateX(74px) rotate(385deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue { display: none; }
  }

  @keyframes impact {
    25% { transform: translate(-3px, 2px); }
    50% { transform: translate(3px, -2px); }
    75% { transform: translate(-1px, 1px); }
  }
</style>
