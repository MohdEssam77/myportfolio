---
import type { HeroProps } from "@types";
import { PLAYER } from "@ui";
import Ball from "@icons/Ball.astro";
type Props = HeroProps;

const { name, specialty, summary, phone } = Astro.props;
const [firstName, ...rest] = name.split(" ");
const lastName = rest.join(" ");
---

<section
  class="hero relative grid min-h-[calc(100dvh-80px)] content-center items-center gap-14 py-16 lg:grid-cols-[1.25fr_1fr] lg:gap-10"
  id="hero"
>
  <div class="relative z-10">
    <p
      class="mb-6 flex items-center gap-3 font-mono text-xs tracking-[0.25em] text-muted uppercase"
    >
      <span
        class="inline-flex items-center gap-2 rounded bg-card-red/15 px-2 py-1 text-card-red"
      >
        <span class="size-1.5 rounded-full bg-card-red"></span>Live
      </span>
      Kick-off · #{PLAYER.number}
    </p>

    <h1
      class="hero-name mb-5 font-display leading-[0.9] font-black tracking-tight text-chalk uppercase"
      aria-label={name}
    >
      <span
        class="slam block text-[clamp(4.5rem,15vw,10.5rem)] lg:text-[clamp(5rem,9.5vw,10.5rem)]"
        >{firstName}</span
      >
      <span
        class="slam slam-late outline-text block text-[clamp(4.5rem,15vw,10.5rem)] text-transparent lg:text-[clamp(5rem,9.5vw,10.5rem)]"
        >{lastName}</span
      >
    </h1>

    <p
      class="mb-6 font-display text-4xl font-bold tracking-wide text-floodlight uppercase sm:text-5xl"
    >
      {specialty}
    </p>
    <p class="mb-10 max-w-xl text-base text-muted md:text-lg">
      {summary}
    </p>

    <div class="flex flex-wrap gap-3">
      {
        phone && (
          <a data-magnetic class="btn-kick btn-ghost" href={`tel:${phone}`}>
            Call Me
          </a>
        )
      }
      <a data-magnetic class="btn-kick btn-primary" href="#contact"
        >Contact Me</a
      >
      <a
        data-magnetic
        class="btn-kick btn-ghost"
        href="/Halboup_Mohammed.pdf"
        download="Mohammed_Halboup_Resume.pdf">Download Resume</a
      >
    </div>

    <button
      type="button"
      class="group mt-6 inline-flex items-center gap-2.5 font-mono text-xs tracking-wide text-muted transition-colors hover:text-chalk"
      data-play-highlights
    >
      <span
        class="grid size-7 place-items-center rounded-full bg-chalk/10 text-floodlight transition-colors group-hover:bg-floodlight group-hover:text-pitch"
        aria-hidden="true"
      >
        <svg width="10" height="10" viewBox="0 0 10 10" fill="currentColor"
          ><path d="M2 1l7 4-7 4z"></path></svg
        >
      </span>
      No time to scroll? Watch the 30-second highlights
    </button>
  </div>

  <div class="relative flex justify-center lg:justify-end" data-card-slot>
    <slot name="card" />
  </div>

  <a
    href="#experience"
    class="scroll-cue absolute bottom-2 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[11px] tracking-[0.25em] text-muted uppercase transition-colors hover:text-chalk lg:flex"
  >
    <span class="ball-track relative block h-6 w-24">
      <Ball class="ball absolute top-0 left-0" size={22} />
    </span>
    Scroll to kick off
  </a>
</section>

<script>
  import { autoKickoff } from "@lib/kickoff";
  autoKickoff();

  document
    .querySelector("[data-play-highlights]")
    ?.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("matchday:highlights"));
    });

  // The scroll cue only belongs to the kick-off screen: hide it as soon as
  // the visitor starts scrolling, bring it back only at the very top.
  const cue = document.querySelector<HTMLElement>(".scroll-cue");
  const syncCue = () => cue?.classList.toggle("is-gone", window.scrollY > 40);
  syncCue();
  window.addEventListener("scroll", syncCue, { passive: true });
</script>

<style>
  .outline-text {
    -webkit-text-stroke: 2px var(--color-chalk);
  }

  :global(html.intro) .slam {
    opacity: 0;
  }

  :global(html.kicked) .slam {
    animation: slam 520ms cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }

  :global(html.kicked) .slam-late {
    animation-delay: 140ms;
  }

  :global(html.kicked) .hero {
    animation: impact 320ms ease-out 480ms;
  }

  @keyframes slam {
    0% {
      opacity: 0;
      transform: scale(1.6) translateY(-12px);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  .ball {
    animation: roll 2.8s ease-in-out infinite;
  }

  @keyframes roll {
    0%,
    100% {
      transform: translateX(0) rotate(0deg);
    }
    50% {
      transform: translateX(74px) rotate(385deg);
    }
  }

  .scroll-cue {
    transition:
      opacity 300ms ease,
      visibility 300ms;
  }

  .scroll-cue.is-gone {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      display: none;
    }
  }

  @keyframes impact {
    25% {
      transform: translate(-3px, 2px);
    }
    50% {
      transform: translate(3px, -2px);
    }
    75% {
      transform: translate(-1px, 1px);
    }
  }
</style>
