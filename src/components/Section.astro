---
interface Props {
  text: string;
  href: string;
  wide?: boolean;
}

const { text, href, wide = false } = Astro.props;
---

<section id={href} class:list={["py-24", !wide && "mx-auto max-w-3xl"]}>
  <h2
    class="mb-14 font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
  >
    {text}
  </h2>
  <slot />
</section>
