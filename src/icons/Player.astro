---
// #17 in the lime kit, side view, facing right. Shared by the cursor and the
// penalty shootout. Poses come from classes on any ancestor:
//   .is-running   run cycle (legs and arms swing)
//   .is-kicking   one kick with the front (right) leg
//   .is-left      the parent is mirrored; keeps the shirt number readable
interface Props {
  class?: string;
  width?: number;
  height?: number;
}

const { class: className, width = 28, height = 40 } = Astro.props;
---

<svg class={className} width={width} height={height} viewBox="0 0 28 40" fill="none" aria-hidden="true">
  <g stroke="#0a1f17" stroke-width="1" stroke-linejoin="round">
    <!-- back arm, back leg -->
    <path class="pc-arm-back" d="M10 14l-3.5 6" stroke="#9fcc30" stroke-width="3" stroke-linecap="round"></path>
    <g class="pc-leg-back">
      <path d="M12 27l-0.5 8" stroke="#c48a5e" stroke-width="2.8" stroke-linecap="round"></path>
      <path d="M9.5 35.5h4.5v2.5h-5z" fill="#0a1f17"></path>
    </g>
    <!-- shorts, shirt, head -->
    <path d="M8.5 22.5h11l0.5 5.5h-4.6l-1.4-2-1.4 2H8z" fill="#e8efe9"></path>
    <path d="M9 11.5c1.5-1 3-1.5 5-1.5s3.5 0.5 5 1.5l0.5 11.5h-11z" fill="#c8ff3d"></path>
    <text
      class="pc-number"
      x="14"
      y="20.5"
      text-anchor="middle"
      font-size="6.5"
      font-weight="900"
      fill="#0a1f17"
      stroke="none"
      font-family="ui-sans-serif, system-ui">17</text
    >
    <circle cx="14" cy="6" r="4.3" fill="#c48a5e"></circle>
    <path
      d="M9.8 5.4c0-2.8 2-4.2 4.2-4.2 2.4 0 4.3 1.4 4.3 3.9-1.6-0.9-3.7-1.2-5.4-0.6-1.3 0.4-2.3 0.6-3.1 0.9z"
      fill="#4a2e1c"></path>
    <!-- front leg (the kicking one), front arm -->
    <g class="pc-leg-front">
      <path d="M16 27l0.5 8" stroke="#c48a5e" stroke-width="2.8" stroke-linecap="round"></path>
      <path d="M15 35.5h4.5l0.5 2.5h-5z" fill="#0a1f17"></path>
    </g>
    <path class="pc-arm-front" d="M18 14l3.5 6" stroke="#c8ff3d" stroke-width="3" stroke-linecap="round"></path>
  </g>
</svg>

<style>
  .pc-number {
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.is-left) .pc-number {
    transform: scaleX(-1);
  }

  .pc-leg-back,
  .pc-leg-front,
  .pc-arm-back,
  .pc-arm-front {
    transform-box: view-box;
  }

  .pc-leg-back {
    transform-origin: 12px 27px;
  }

  .pc-leg-front {
    transform-origin: 16px 27px;
  }

  .pc-arm-back {
    transform-origin: 10px 14px;
  }

  .pc-arm-front {
    transform-origin: 18px 14px;
  }

  :global(.is-running) .pc-leg-back,
  :global(.is-running) .pc-arm-front {
    animation: player-stride 280ms ease-in-out infinite alternate;
  }

  :global(.is-running) .pc-leg-front,
  :global(.is-running) .pc-arm-back {
    animation: player-stride 280ms ease-in-out infinite alternate-reverse;
  }

  /* Backswing, strike (at ~150ms), follow-through. Listed after the run
     cycle so the kicking leg wins while he runs. */
  :global(.is-kicking) .pc-leg-front {
    animation: player-kick 320ms ease-out;
  }

  :global(.is-kicking) .pc-arm-back {
    animation: player-kick-arm 320ms ease-out;
  }

  @keyframes player-stride {
    from {
      transform: rotate(-28deg);
    }
    to {
      transform: rotate(28deg);
    }
  }

  @keyframes player-kick {
    35% {
      transform: rotate(40deg);
    }
    50% {
      transform: rotate(-80deg);
    }
  }

  @keyframes player-kick-arm {
    50% {
      transform: rotate(-60deg);
    }
  }
</style>
