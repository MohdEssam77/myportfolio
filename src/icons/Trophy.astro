---
import type { TrophyTier } from "@ui";

interface Props {
  tier: TrophyTier;
  id: string;
  class?: string;
}

const { tier, id, class: className } = Astro.props;

const PALETTE: Record<TrophyTier, [string, string, string]> = {
  gold: ["#fff1a8", "#f5c542", "#9a6b06"],
  silver: ["#ffffff", "#cdd6dc", "#6f7c86"],
  bronze: ["#ffd2a8", "#d68a4c", "#7a3f16"],
  medal: ["#f4ffd0", "#c8ff3d", "#5f7d12"],
};
const PLACE: Record<TrophyTier, string> = { gold: "1", silver: "2", bronze: "3", medal: "★" };

const [light, mid, dark] = PALETTE[tier];
const fill = `trophy-fill-${id}`;
const clip = `trophy-clip-${id}`;
const cup =
  "M22 10H78V40C78 62 66 76 50 78C34 76 22 62 22 40Z M45 78H55V98H45Z M38 97H62V104H38Z M28 108H72L76 128H24Z";
---

<svg class:list={["trophy", className]} viewBox="0 0 100 132" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={fill} x1="0" y1="0" x2="1" y2="0.3">
      <stop offset="0" stop-color={dark}></stop>
      <stop offset="0.35" stop-color={light}></stop>
      <stop offset="0.6" stop-color={mid}></stop>
      <stop offset="1" stop-color={dark}></stop>
    </linearGradient>
    <clipPath id={clip}>
      <path d={cup}></path>
    </clipPath>
  </defs>

  {
    tier === "medal" ? (
      <g>
        <path d="M34 4h14l8 40H42zM66 4H52l-8 40h14z" fill={dark} opacity="0.8" />
        <circle cx="50" cy="78" r="34" fill={`url(#${fill})`} stroke={dark} stroke-width="2" />
        <circle cx="50" cy="78" r="24" stroke={light} stroke-opacity="0.6" stroke-width="2" />
      </g>
    ) : (
      <g>
        <path
          d="M22 18H10C8 36 16 50 27 54M78 18H90C92 36 84 50 73 54"
          stroke={`url(#${fill})`}
          stroke-width="6"
          stroke-linecap="round"
        />
        <path d={cup} fill={`url(#${fill})`} />
        <rect x="36" y="114" width="28" height="8" rx="1.5" fill={dark} opacity="0.55" />
        <g clip-path={`url(#${clip})`}>
          <rect class="trophy-shine" x="-60" y="0" width="30" height="132" fill="#fff" opacity="0.55" transform="skewX(-20)" />
        </g>
      </g>
    )
  }
  <text
    x="50"
    y={tier === "medal" ? 88 : 52}
    text-anchor="middle"
    font-family="Big Shoulders Display, sans-serif"
    font-weight="900"
    font-size="28"
    fill={dark}
    opacity="0.75">{PLACE[tier]}</text
  >
</svg>

<style>
  .trophy-shine {
    transform: translateX(0) skewX(-20deg);
  }

  :global(.trophy-btn:hover) .trophy-shine,
  :global(.trophy-btn:focus-visible) .trophy-shine {
    transition: transform 700ms ease;
    transform: translateX(200px) skewX(-20deg);
  }
</style>
